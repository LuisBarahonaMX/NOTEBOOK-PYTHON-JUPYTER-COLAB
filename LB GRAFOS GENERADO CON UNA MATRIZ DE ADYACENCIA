 len(nodos) < 10:\n","    fig_size = (6, 6)  # Imagen pequeña\n","    node_size = 1200\n","    font_size = 10\n","    edge_width = 1.5\n","elif len(nodos) < 20:\n","    fig_size = (8, 8)  # Imagen mediana\n","    node_size = 800\n","    font_size = 8\n","    edge_width = 1.2\n","else:\n","    fig_size = (12, 12)  # Imagen grande\n","    node_size = 500\n","    font_size = 6\n","    edge_width = 1.0\n","\n","# Crear el grafo (dirigido o no dirigido según el archivo)\n","G = nx.DiGraph() if tipo_grafo == \"DIRIGIDO\" else nx.Graph()\n","\n","# Agregar nodos al grafo\n","for nodo in nodos:\n","    G.add_node(nodo)\n","\n","# Agregar aristas con pesos si existen\n","edges = []\n","for i in range(len(nodos)):\n","    for j in range(len(nodos)):\n","        if df.iloc[i, j] == 1:  # Si hay conexión\n","            peso = matriz_pesos.iloc[i, j] if 'matriz_pesos' in globals() else None\n","            edges.append((nodos[i], nodos[j], peso))\n","\n","# Añadir aristas al grafo con pesos\n","for u, v, peso in edges:\n","    if peso is not None:\n","        G.add_edge(u, v, weight=peso)\n","    else:\n","        G.add_edge(u, v)\n","\n","# Posiciones de los nodos\n","pos = nx.spring_layout(G, seed=162)\n","\n","# Crear la figura con el tamaño ajustado\n","plt.figure(figsize=fig_size)\n","\n","# Dibujar nodos con diferentes colores\n","node_colors = range(len(G.nodes))\n","nx.draw(G, pos, with_labels=True, node_color=node_colors, cmap=plt.cm.Set2, node_size=node_size,\n","        edge_color=\"gray\", font_size=font_size, font_weight=\"bold\", width=edge_width)\n","\n","# Dibujar etiquetas de los pesos de las aristas si existen\n","edge_labels = {(u, v): f\"{peso}\" for u, v, peso in edges if peso is not None}\n","nx.draw_networkx_edge_labels(G, pos, edge_labels=edge_labels, font_size=font_size, font_color=\"red\")\n","\n","# Mostrar el grafo\n","plt.title(f\"Grafo {tipo_grafo}\")\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":659},"id":"lk32oYnE1SPv","executionInfo":{"status":"ok","timestamp":1738923199436,"user_tz":300,"elapsed":319,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"6a5aa5ba-7563-48fc-8092-12b89485f7b0"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["###Visualización como Árbol Binario**\n","- Se intenta organizar el grafo como un **árbol binario**.\n","- Se usa **Graphviz** para estructurarlo jerárquicamente.\n","- Si no es posible, se usa una distribución alternativa.\n"],"metadata":{"id":"thcObSi57nO-"}},{"cell_type":"code","source":["from networkx.drawing.nx_pydot import graphviz_layout\n","\n","# Determinar el tamaño de la figura según el número de nodos\n","num_nodos = len(nodos)\n","\n","if num_nodos < 10:\n","    fig_size = (6, 6)  # Imagen pequeña\n","    node_size = 1200\n","    font_size = 10\n","    edge_width = 1.5\n","elif num_nodos < 20:\n","    fig_size = (8, 8)  # Imagen mediana\n","    node_size = 800\n","    font_size = 8\n","    edge_width = 1.2\n","else:\n","    fig_size = (12, 12)  # Imagen grande\n","    node_size = 500\n","    font_size = 6\n","    edge_width = 1.0\n","\n","# Verificar si el grafo es dirigido para elegir la representación correcta\n","G_tree = nx.DiGraph() if tipo_grafo == \"DIRIGIDO\" else nx.Graph()\n","\n","# Añadir nodos y conexiones para formar una estructura de árbol binario\n","added_nodes = set()\n","for u, v, _ in edges:\n","    G_tree.add_edge(u, v)\n","    added_nodes.add(u)\n","    added_nodes.add(v)\n","\n","# Intentar posicionar el grafo como un árbol binario\n","try:\n","    pos = graphviz_layout(G_tree, prog=\"dot\")\n","except:\n","    print(\"No se pudo generar una estructura de árbol binario automáticamente.\")\n","    pos = nx.spring_layout(G_tree, seed=42)  # Fallback a spring layout\n","\n","# Crear la figura con el tamaño ajustado\n","plt.figure(figsize=fig_size)\n","\n","# Dibujar nodos y conexiones\n","nx.draw(G_tree, pos, with_labels=True, node_color=\"lightblue\", edge_color=\"gray\", node_size=node_size, font_size=font_size, font_weight=\"bold\", width=edge_width)\n","\n","# Dibujar los pesos si existen\n","edge_labels = {(u, v): f\"{peso}\" for u, v, peso in edges if peso is not None}\n","nx.draw_networkx_edge_labels(G_tree, pos, edge_labels=edge_labels, font_size=font_size, font_color=\"red\")\n","\n","# Mostrar la visualización\n","plt.title(\"Visualización del Grafo como Árbol Binario\")\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":659},"id":"B_NOSBXP2kCG","executionInfo":{"status":"ok","timestamp":1738923209319,"user_tz":300,"elapsed":642,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"a5835769-73f9-46dd-c8ad-f7384437b02e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["###Aplicación del Árbol Binario de Búsqueda (ABB)**\n","- Se construye un **Árbol Binario de Búsqueda** con los nodos.\n","- Se inserta cada nodo respetando el orden del ABB.\n","- Se dibuja el árbol para ver su estructura ordenada."],"metadata":{"id":"1I0Y_Bcf7uk5"}},{"cell_type":"markdown","source":["## Visualización del Camino Más Corto con Dijkstra\n","\n","Esta celda aplica el **algoritmo de Dijkstra** para encontrar el **camino más corto** entre dos nodos en el grafo.\n","\n","### 🔹 ¿Qué hace esta celda?\n","1. **Solicita un nodo de inicio y un nodo destino**.\n","2. **Calcula el camino más corto** y la **suma correcta de los pesos** en cada arista.\n","3. **Muestra el recorrido con la acumulación de pesos** (`a + b + c = abc`).\n","4. **Dibuja el grafo resaltando el camino más corto** en **rojo**.\n","5. **Etiqueta el nodo destino con la distancia total**.\n","\n","\n"],"metadata":{"id":"e65qA7NUG_lU"}},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","\n","# Preguntar el nodo origen\n","nodo_origen = input(\"Ingrese el nodo de inicio para encontrar el camino más corto: \").strip().upper()\n","\n","# Verificar que el nodo existe en la lista de nodos\n","if nodo_origen not in nodos:\n","    print(\"Error: El nodo ingresado no existe en el grafo.\")\n","else:\n","    # Determinar el tamaño de la figura según el número de nodos\n","    num_nodos = len(nodos)\n","\n","    if num_nodos < 10:\n","        fig_size = (6, 6)  # Imagen pequeña\n","        node_size = 1200\n","        font_size = 10\n","        edge_width = 1.5\n","    elif num_nodos < 20:\n","        fig_size = (8, 8)  # Imagen mediana\n","        node_size = 800\n","        font_size = 8\n","        edge_width = 1.2\n","    else:\n","        fig_size = (12, 12)  # Imagen grande\n","        node_size = 500\n","        font_size = 6\n","        edge_width = 1.0\n","\n","    # Crear un grafo dirigido o no dirigido según el tipo de grafo\n","    G_dijkstra = nx.DiGraph() if tipo_grafo == \"DIRIGIDO\" else nx.Graph()\n","\n","    # Agregar nodos al grafo\n","    for nodo in nodos:\n","        G_dijkstra.add_node(nodo)\n","\n","    # Agregar aristas con pesos desde el DataFrame `matriz_pesos`\n","    for i in range(len(nodos)):\n","        for j in range(len(nodos)):\n","            peso = matriz_pesos.iloc[i, j]\n","            if peso > 0:  # Si hay conexión con peso\n","                G_dijkstra.add_edge(nodos[i], nodos[j], weight=peso)\n","\n","    # Aplicar el algoritmo de Dijkstra desde el nodo origen\n","    caminos_mas_cortos = nx.single_source_dijkstra_path(G_dijkstra, nodo_origen)\n","    distancias = nx.single_source_dijkstra_path_length(G_dijkstra, nodo_origen)\n","\n","    # Preguntar el nodo destino\n","    nodo_destino = input(f\"Ingrese el nodo destino (desde {nodo_origen}): \").strip().upper()\n","\n","    # Verificar si el nodo