]},{"cell_type":"code","source":["from huggingface_hub import hf_hub_download\n","\n","archivo = hf_hub_download(\n","    repo_id=\"google/medgemma-1.5-4b-it\",\n","    filename=\"config.json\",\n","    token=True\n",")\n","\n","print(\"✅ Acceso confirmado. Listo para cargar MedGemma.\")"],"metadata":{"id":"iaZDwGmXbN5P"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import torch\n","from transformers import AutoProcessor, AutoModelForImageTextToText\n","\n","assert torch.cuda.is_available(), \"Activa la GPU en Colab antes de continuar.\"\n","\n","MODEL_ID = \"google/medgemma-1.5-4b-it\"\n","\n","processor = AutoProcessor.from_pretrained(\n","    MODEL_ID,\n","    token=True\n",")\n","\n","model = AutoModelForImageTextToText.from_pretrained(\n","    MODEL_ID,\n","    torch_dtype=torch.float16,\n","    device_map=\"auto\",\n","    token=True\n",")\n","\n","model.eval()\n","\n","print(\"✅ MedGemma cargado\")\n","print(\"GPU:\", torch.cuda.get_device_name(0))\n"],"metadata":{"id":"4J-WHf8tbXPB"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["messages = [\n","    {\n","        \"role\": \"user\",\n","        \"content\": [\n","            {\n","                \"type\": \"text\",\n","                \"text\": (\n","                    \"Responde en español y con lenguaje sencillo: \"\n","                    \"¿Qué diferencia hay entre un síntoma y un signo médico? \"\n","                    \"Da un ejemplo de cada uno.\"\n","                )\n","            }\n","        ]\n","    }\n","]\n","\n","inputs = processor.apply_chat_template(\n","    messages,\n","    add_generation_prompt=True,\n","    tokenize=True,\n","    return_dict=True,\n","    return_tensors=\"pt\"\n",").to(model.device)\n","\n","longitud_entrada = inputs[\"input_ids\"].shape[-1]\n","\n","with torch.inference_mode():\n","    salida = model.generate(\n","        **inputs,\n","        max_new_tokens=250,\n","        do_sample=False\n","    )\n","\n","respuesta = processor.decode(\n","    salida[0][longitud_entrada:],\n","    skip_special_tokens=True\n",")\n","\n","print(respuesta)"],"metadata":{"id":"BuvfPzHFbamJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["messages = [\n","    {\n","        \"role\": \"user\",\n","        \"content\": [\n","            {\n","                \"type\": \"text\",\n","                \"text\": (\n","                    \"Responde en español con lenguaje sencillo: \"\n","                    \"¿Qué diferencia hay entre un síntoma y un signo médico? \"\n","                    \"Da un ejemplo de cada uno.\"\n","                )\n","            }\n","        ]\n","    }\n","]\n","\n","inputs = processor.apply_chat_template(\n","    messages,\n","    add_generation_prompt=True,\n","    tokenize=True,\n","    return_dict=True,\n","    return_tensors=\"pt\"\n",").to(model.device)\n","\n","longitud_entrada = inputs[\"input_ids\"].shape[-1]\n","\n","with torch.inference_mode():\n","    salida = model.generate(\n","        **inputs,\n","        max_new_tokens=250,\n","        do_sample=False\n","    )\n","\n","respuesta = processor.decode(\n","    salida[0][longitud_entrada:],\n","    skip_special_tokens=True\n",")\n","\n","print(\"RESPUESTA DE MEDGEMMA:\\n\")\n","print(respuesta)"],"metadata":{"id":"muTwCVPrecrY"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["tokens_nuevos = salida[0][longitud_entrada:]\n","\n","print(\"Cantidad de tokens generados:\", len(tokens_nuevos))\n","print(\"Respuesta:\", repr(respuesta))\n","print(\n","    \"Salida incluyendo tokens especiales:\",\n","    processor.decode(tokens_nuevos, skip_special_tokens=False)\n",")"],"metadata":{"id":"_QGfS-oAghEY"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["%pip install -U bitsandbytes\n"],"metadata":{"id":"B-FrHGw_g0T5"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import gc\n","import torch\n","from transformers import (\n","    AutoProcessor,\n","    AutoModelForImageTextToText,\n","    BitsAndBytesConfig\n",")\n","\n","# Liberar las variables de la prueba anterior\n","for nombre in [\"model\", \"inputs\", \"salida\", \"tokens_nuevos\"]:\n","    globals().pop(nombre, None)\n","\n","gc.collect()\n","torch.cuda.empty_cache()\n","\n","MODEL_ID = \"google/medgemma-1.5-4b-it\"\n","\n","configuracion_4bits = BitsAndBytesConfig(\n","    load_in_4bit=True,\n","    bnb_4bit_quant_type=\"nf4\",\n","    bnb_4bit_compute_dtype=torch.float32\n",")\n","\n","processor = AutoProcessor.from_pretrained(\n","    MODEL_ID,\n","    token=True\n",")\n","\n","model = AutoModelForImageTextToText.from_pretrained(\n","    MODEL_ID,\n","    token=True,\n","    device_map=\"auto\",\n","    quantization_config=configuracion_4bits,\n","    torch_dtype=torch.float32,\n","    attn_implementation=\"eager\"\n",")\n","\n","model.eval()\n","print(\"✅ Modelo cargado con la nueva configuración\")"],"metadata":{"id":"BI_-23kcg2n_"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["messages = [{\n","    \"role\": \"user\",\n","    \"content\": [{\n","        \"type\": \"text\",\n","        \"text\": \"Responde en español: ¿qué es un síntoma? Contesta en dos frases.\"\n","    }]\n","}]\n","\n","inputs = processor.apply_chat_template(\n","    messages,\n","    add_generation_prompt=True,\n","    tokenize=True,\n","    return_dict=True,\n","    return_tensors=\"pt\"\n",").to(model.device)\n","\n","with torch.inference_mode():\n","    salida = model.generate(\n","        **inputs,\n","        max_new_tokens=80,\n","        do_sample=False\n","    )\n","\n","tokens_nuevos = salida[0][inputs[\"input_ids\"].shape[-1]:]\n","respuesta = processor.decode(\n","    tokens_nuevos,\n","    skip_special_tokens=True\n",")\n","\n","print(\"Respuesta:\", repr(respuesta))\n","\n","if not respuesta.strip():\n","    print(processor.decode(tokens_nuevos, skip_special_tokens=False))"],"metadata":{"id":"MmdNsc5Sg5hy"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import html\n","import time\n","import torch\n","import ipywidgets as widgets\n","from IPython.display import display, clear_output\n","\n","entrada = widgets.Textarea(\n","    placeholder=\"Escribe tu pregunta para MedGemma...\",\n","    layout=widgets.Layout(width=\"100%\", height=\"130px\")\n",")\n","\n","limite = widgets.IntSlider(\n","    value=200,\n","    min=50,\n","    max=500,\n","    step=50,\n","    description=\"Máx. tokens:\",\n","    style={\"description_width\": \"initial\"}\n",")\n","\n","consultar = widgets.Button(\n","    description=\"Consultar modelo\",\n","    icon=\"paper-plane\",\n","    button_style=\"primary\"\n",")\n","\n","limpiar = widgets.Button(\n","    description=\"Limpiar\",\n","    icon=\"trash\"\n",")\n","\n","estado = widgets.HTML()\n","resultado = widgets.Output()\n","\n","def ejecutar_consulta(_):\n","    pregunta = entrada.value.strip()\n","\n","    if not pregunta:\n","        estado.value = \"⚠️ Escribe una pregunta primero.\"\n","        return\n","\n","    consultar.disabled = True\n","    limpiar.disabled = True\n","    estado.value = \"⏳ MedGemma está generando la respuesta...\"\n","\n","    with resultado:\n","        clear_output(wait=True)\n","\n","    inicio = time.perf_counter()\n","\n","    try:\n","        mensajes = [{\n","            \"role\": \"user\",\n","            \"content\": [{\n","                \"type\": \"text\",\n","                \"text\": (\n","                    \"Responde en español con lenguaje claro. \"\n","                    \"Indica cuando exista incertidumbre.\\n\\n\"\n","                    + pregunta\n","                )\n","            }]\n","        }]\n","\n","        datos = processor.apply_chat_template(\n","            mensajes,\n","            add_generation_prompt=True,\n","            tokenize=True,\n","            return_dict=True,\n","            return_tensors=\"pt\"\n","        ).to(model.device)\n","\n","        with torch.inference_mode():\n","            generacion = model.generate(\n","                **datos,\n","                max_new_tokens=limite.value,\n","                do_sample=False\n","            )\n","\n","        nuevos = generacion[0][datos[\"input_ids\"].shape[-1]:]\n","        texto = processor.decode(\n","            nuevos,\n","            skip_special_tokens=True\n","        ).strip()\n","\n","        with resultado:\n","            display(widgets.HTML(\n","                value=(\n","                    \"<div style='padding:16px;border:1px solid #aaa;\"\n","                    \"border-radius:10px;white-space:pre-wrap;\"\n","                    \"overflow-wrap:anywhere'>\"\n","                    + html.escape(texto or \"El modelo no generó texto.\")\n","                    + \"</div>\"\n","                )\n","            ))\n","\n","        segundos = time.perf_counter() - inicio\n","        estado.value = (\n","            f\"✅ Consulta terminada en {segundos:.1f} segundos.\"\n","        )\n","\n","    except Exception as error:\n","        estado.value = \"❌ No se pudo completar la consulta.\"\n","        with resultado:\n","            print(f\"{type(error).__name__}: {error}\")\n","\n","    finally:\n","        consultar.disabled = False\n","        limpiar.disabled = False\n","\n","def borrar(_):\n","    entrada.value = \"\"\n","    estado.value = \"\"\n","    with resultado:\n","        clear_output()\n","\n","consultar.on_click(ejecutar_consulta)\n","limpiar.on_click(borrar)\n","\n","display(widgets.VBox([\n","    widgets.HTML(\n","        \"<h3>Pruebas de MedGemma</h3>\"\n","        \"<p>Cada consulta es independiente y no conserva historial. \"\n","        \"Prototipo experimental: las respuestas requieren revisión; \"\n","        \"no ingreses datos personales de pacientes.</p>\"\n","    ),\n","    entrada,\n","    limite,\n","    widgets.HBox([consultar, limpiar]),\n","    estado,\n","    resultado\n","]))"],"metadata":{"id":"4NzXu0J1iZvG"},"execution_count":null,"outputs":[]}]}