ecificar el número de líneas que se generarán, y cada línea se dibujará entre dos puntos aleatorios en el espacio 3D. Además, se calcula el volumen aproximado del espacio delimitado por las líneas y la cantidad de caras que conforman las líneas generadas.\n"],"metadata":{"id":"eVEYt3Ns1665"}},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from mpl_toolkits.mplot3d import Axes3D\n","\n","def draw_lines_3d(lines):\n","    fig = plt.figure(figsize=(10, 10))\n","    ax = fig.add_subplot(111, projection='3d')\n","    for line in lines:\n","        (x1, y1, z1), (x2, y2, z2) = line\n","        ax.plot([x1, x2], [y1, y2], [z1, z2], 'bo-')\n","    ax.set_xlabel('X')\n","    ax.set_ylabel('Y')\n","    ax.set_zlabel('Z')\n","    ax.set_title('Líneas en 3D')\n","    plt.show()\n","\n","def calculate_volume_and_faces(lines):\n","    # Calcular el volumen aproximado usando el método de Monte Carlo\n","    num_points = 10000\n","    max_x = max([max(line[0][0], line[1][0]) for line in lines])\n","    max_y = max([max(line[0][1], line[1][1]) for line in lines])\n","    max_z = max([max(line[0][2], line[1][2]) for line in lines])\n","    points_inside = 0\n","    for _ in range(num_points):\n","        x, y, z = np.random.rand(3) * [max_x, max_y, max_z]\n","        for line in lines:\n","            (x1, y1, z1), (x2, y2, z2) = line\n","            if (x1 <= x <= x2 or x2 <= x <= x1) and (y1 <= y <= y2 or y2 <= y <= y1) and (z1 <= z <= z2 or z2 <= z <= z1):\n","                points_inside += 1\n","                break\n","    volume = max_x * max_y * max_z * (points_inside / num_points)\n","\n","    # Calcular la cantidad de caras\n","    num_faces = len(lines)\n","\n","    return volume, num_faces\n","\n","def main():\n","    num_lines = int(input(\"Ingrese el número de líneas aleatorias a generar: \"))\n","    lines = []\n","    for i in range(num_lines):\n","        x1, y1, z1, x2, y2, z2 = np.random.rand(6) * 10\n","        lines.append(((x1, y1, z1), (x2, y2, z2)))\n","\n","    draw_lines_3d(lines)\n","\n","    volume, num_faces = calculate_volume_and_faces(lines)\n","    print(\"Volumen aproximado:\", volume)\n","    print(\"Cantidad de caras:\", num_faces)\n","\n","if __name__ == \"__main__\":\n","    main()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":881},"id":"CRD-_2Audxo3","executionInfo":{"status":"ok","timestamp":1713459839637,"user_tz":300,"elapsed":4086,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"0814d7ca-3621-4846-83a3-9f5eb9257b28"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese el número de líneas aleatorias a generar: 66\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1000 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Volumen aproximado: 681.7323678565007\n","Cantidad de caras: 66\n"]}]},{"cell_type":"markdown","source":["# Detección de Intersecciones entre Líneas en 3D\n","\n","## Descripción:Este código detecta las intersecciones entre un conjunto de líneas aleatorias en un espacio tridimensional (3D). Utiliza el método de determinantes para calcular si dos líneas se intersectan en el espacio 3D y cuenta el número total de intersecciones encontradas. Además, visualiza gráficamente las líneas generadas en el espacio 3D y muestra el volumen aproximado del espacio delimitado por las líneas y la cantidad de caras que conforman las líneas generadas.\n"],"metadata":{"id":"hIRbXGDf2Efi"}},{"cell_type":"code","source":["def calculate_intersections(lines):\n","    num_intersections = 0\n","    for i, line1 in enumerate(lines):\n","        for line2 in lines[i+1:]:\n","            xdiff = (line1[0][0] - line1[1][0], line2[0][0] - line2[1][0])\n","            ydiff = (line1[0][1] - line1[1][1], line2[0][1] - line2[1][1])\n","            zdiff = (line1[0][2] - line1[1][2], line2[0][2] - line2[1][2])\n","\n","            def det(a, b):\n","                return a[0] * b[1] - a[1] * b[0]\n","\n","            div_xy = det(xdiff, ydiff)\n","            div_xz = det(xdiff, zdiff)\n","            div_yz = det(ydiff, zdiff)\n","\n","            if div_xy == 0 or div_xz == 0 or div_yz == 0:\n","                continue\n","\n","            d_xy = (det(*line1[:2]), det(*line2[:2]))\n","            d_xz = (det(line1[0][::2], line1[1][::2]), det(line2[0][::2], line2[1][::2]))\n","            d_yz = (det(line1[0][1:], line1[1][1:]), det(line2[0][1:], line2[1][1:]))\n","\n","            x = det(d_xy, xdiff) / div_xy\n","            y = det(d_xy, ydiff) / div_xy\n","            z = det(d_xz, xdiff) / div_xz\n","            if (min(line1[0][0], line1[1][0]) <= x <= max(line1[0][0], line1[1][0]) and\n","                min(line1[0][1], line1[1][1]) <= y <= max(line1[0][1], line1[1][1]) and\n","                min(line2[0][0], line2[1][0]) <= x <= max(line2[0][0], line2[1][0]) and\n","                min(line2[0][1], line2[1][1]) <= y <= max(line2[0][1], line2[1][1])):\n","                num_intersections += 1\n","\n","    return num_intersections\n","\n","def main():\n","    num_lines = int(input(\"Ingrese el número de líneas aleatorias a generar: \"))\n","    lines = []\n","    for i in range(num_lines):\n","        x1, y1, z1, x2, y2, z2 = np.random.rand(6) * 10\n","        lines.append(((x1, y1, z1), (x2, y2, z2)))\n","\n","    draw_lines_3d(lines)\n","\n","    volume, num_faces = calculate_volume_and_faces(lines)\n","    print(\"Volumen aproximado:\", volume)\n","    print(\"Cantidad de caras:\", num_faces)\n","\n","    num_intersections = calculate_intersections(lines)\n","    print(\"Número de intersecciones entre líneas:\", num_intersections)\n","\n","if __name__ == \"__main__\":\n","    main()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":898},"id":"aFzNJ7WBeUwr","executionInfo":{"status":"ok","timestamp":1713459848419,"user_tz":300,