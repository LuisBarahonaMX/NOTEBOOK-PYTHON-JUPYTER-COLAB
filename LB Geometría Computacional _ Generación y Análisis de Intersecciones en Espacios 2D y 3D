ilizando Matplotlib.\n","\n","##El proceso de detección de intersecciones se realiza mediante la comparación de cada par de líneas generadas. Si dos líneas se cruzan en algún punto del espacio tridimensional, se registra la coordenada de la intersección y se indica qué líneas están involucradas en la intersección.\n","\n","## Requisitos del Usuario:\n","- Especificar el número de líneas a generar (hasta un máximo de 99).\n"],"metadata":{"id":"q7XWtYcT3eyC"}},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from mpl_toolkits.mplot3d import Axes3D\n","\n","def generate_lines(num_lines):\n","    lines = []\n","    for i in range(num_lines):\n","        x1, y1, z1 = np.random.rand(3) * 10\n","        x2, y2, z2 = np.random.rand(3) * 10\n","        lines.append(((x1, y1, z1), (x2, y2, z2)))\n","    return lines\n","\n","def plot_lines(lines):\n","    fig = plt.figure(figsize=(10, 8))\n","    ax = fig.add_subplot(111, projection='3d')\n","\n","    for line in lines:\n","        (x1, y1, z1), (x2, y2, z2) = line\n","        ax.plot([x1, x2], [y1, y2], [z1, z2], marker='o')\n","\n","    ax.set_xlabel('X')\n","    ax.set_ylabel('Y')\n","    ax.set_zlabel('Z')\n","    ax.set_title('Líneas en 3D')\n","    plt.show()\n","\n","def calculate_intersections(lines):\n","    intersections = []\n","    for i, line1 in enumerate(lines):\n","        for line2 in lines[i+1:]:\n","            (x1, y1, z1), (x2, y2, z2) = line1\n","            (x3, y3, z3), (x4, y4, z4) = line2\n","\n","            denominator = ((x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)) ** 2\n","            if denominator == 0:\n","                continue\n","\n","            x = (((x1 * y2 - y1 * x2) * (x3 - x4) - (x1 - x2) * (x3 * y4 - y3 * x4)) / denominator) ** 2\n","            y = (((x1 * y2 - y1 * x2) * (y3 - y4) - (y1 - y2) * (x3 * y4 - y3 * x4)) / denominator) ** 2\n","            z = (((x1 - x2) * (y3 * z4 - z3 * y4) - (y1 - y2) * (x3 * z4 - z3 * x4)) / denominator) ** 2\n","            intersections.append(((x, y, z), i))\n","    return intersections\n","\n","def main():\n","    num_lines = int(input(\"Ingrese el número de líneas a generar (máximo 99): \"))\n","    if num_lines > 99:\n","        print(\"El número máximo de líneas es 99.\")\n","        return\n","\n","    lines = generate_lines(num_lines)\n","    plot_lines(lines)\n","\n","    intersections = calculate_intersections(lines)\n","    print(\"Lista de datos:\")\n","    for intersection in intersections:\n","        print(f\"Número de vértices que cruzan en línea {intersection[1]+1}: {intersection[0]}\")\n","\n","if __name__ == \"__main__\":\n","    main()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"jPs-Gq5Nte14","executionInfo":{"status":"ok","timestamp":1713460441523,"user_tz":300,"elapsed":3340,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"ddbe7c9a-bf52-4bc3-f25e-a1ab081b6047"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese el número de líneas a generar (máximo 99): 33\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Lista de datos:\n","Número de vértices que cruzan en línea 1: (0.02554873001537651, 0.0119288324735008, 0.0061009235106708765)\n","Número de vértices que cruzan en línea 1: (0.01022621692494557, 0.013676124398055177, 0.019244868448649317)\n","Número de vértices que cruzan en línea 1: (0.6063173166945433, 5.38016534325681, 0.03399216832518539)\n","Número de vértices que cruzan en línea 1: (0.0379821921554592, 0.04881561398438719, 0.059965926451225594)\n","Número de vértices que cruzan en línea 1: (3.5304780103955387, 0.04031948394298667, 6.749796343625638)\n","Número de vértices que cruzan en línea 1: (1.197710528652161, 0.010038400912401647, 17.53309490212654)\n","Número de vértices que cruzan