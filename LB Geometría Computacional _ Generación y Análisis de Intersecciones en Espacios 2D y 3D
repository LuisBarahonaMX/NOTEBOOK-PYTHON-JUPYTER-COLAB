1][1], line2[0][1] - line2[1][1])\n","\n","        def det(a, b):\n","            return a[0] * b[1] - a[1] * b[0]\n","\n","        div = det(xdiff, ydiff)\n","        if div == 0:\n","            continue\n","        d = (det(*line1), det(*line2))\n","        x = det(d, xdiff) / div\n","        y = det(d, ydiff) / div\n","        if min(line1[0][0], line1[1][0]) <= x <= max(line1[0][0], line1[1][0]) and min(line1[0][1], line1[1][1]) <= y <= max(line1[0][1], line1[1][1]):\n","            if min(line2[0][0], line2[1][0]) <= x <= max(line2[0][0], line2[1][0]) and min(line2[0][1], line2[1][1]) <= y <= max(line2[0][1], line2[1][1]):\n","                intersections.append((x, y))\n","    return intersections\n","\n","def calculate_levels_and_discrepancy(lines):\n","    levels = defaultdict(int)\n","    for line in lines:\n","        (x1, y1), (x2, y2) = line\n","        for x, y in line:\n","            if (x1 < x < x2 and y < y1) or (x1 < x < x2 and y < y2):\n","                levels[(x, y)] += 1\n","    discrepancy = sum(levels.values())\n","    return levels, discrepancy\n","\n","def calculate_distances(lines, intersections):\n","    distances = []\n","    for intersection in intersections:\n","        for i, (line1, line2) in enumerate(combinations(lines, 2)):\n","            dist = np.linalg.norm(np.array(line1).mean(axis=0) - np.array(line2).mean(axis=0))\n","            distances.append((f'L{i+1}', f'L{i+2}', dist, line1, line2))\n","    return distances\n","\n","def main():\n","    num_lines = int(input(\"Ingrese el número de líneas: \"))\n","    line_length = float(input(\"Ingrese la longitud de las líneas (en metros): \"))\n","    lines = []\n","    for i in range(num_lines):\n","        x1, y1, x2, y2 = np.random.rand(4) * line_length\n","        lines.append(((x1, y1), (x2, y2)))\n","\n","    intersections = calculate_intersection(lines)\n","    draw_lines(lines, intersections)\n","\n","    levels, discrepancy = calculate_levels_and_discrepancy(lines)\n","    print(\"Niveles:\", levels)\n","    print(\"Discrepancia:\", discrepancy)\n","\n","    distances = calculate_distances(lines, intersections)\n","    print(\"Distancias entre líneas intersectadas:\")\n","    for distance in distances:\n","        print(f\"{distance[0]} vs {distance[1]}: {distance[2]:.2f} metros, L1: {distance[3]}, L2: {distance[4]}\")\n","\n","if __name__ == \"__main__\":\n","    main()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1QJGWJ2kWeL5zJRJfDLVZSkSbt-TvN6kn"},"id":"AiHXzhtTjNUo","executionInfo":{"status":"error","timestamp":1713459915709,"user_tz":300,"elapsed":63136,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"d5be8e1e-3328-494a-e6c3-ca0d5ef0ac16"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]},{"cell_type":"markdown","source":["# Detección de Intersecciones y Distancias entre Líneas en 2D\n","\n","## Descripción:Este código genera un conjunto de líneas aleatorias en un plano 2D y detecta las intersecciones entre ellas. Luego, calcula las distancias entre los puntos de intersección y muestra gráficamente las líneas y los puntos de intersección. El usuario puede especificar el número de líneas a generar y la longitud de cada línea. Además, se muestra el nivel de cada línea y la discrepancia entre las líneas generadas.\n"],"metadata":{"id":"irtD6qS22XF8"}},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","from collections import defaultdict\n","from itertools import combinations\n","\n","def draw_lines(lines, intersections):\n","    plt.figure(figsize=(8, 8))\n","    for line in lines:\n","        (x1, y1), (x2, y2) = line\n","        plt.plot([x1, x2], [y1, y2], 'bo-')\n","    for intersection in intersections:\n","        plt.plot(intersection[0], intersection[1], 'ro')\n","    plt.xlabel('X')\n","    plt.ylabel('Y')\n","    plt.title('Líneas y Puntos de Intersección')\n","    plt.grid(True)\n","    plt.show()\n","\n","def calculate_intersection(lines):\n","    intersections = []\n","    for i, line1 in enumerate(lines):\n","        for line2 in lines[i+1:]:\n","            xdiff = (line1[0][0] - line1[1][0], line2[0][0] - line2[1][0])\n","            ydiff = (line1[0][1] - line1[1][1], line2[0][1] - line2[1][1])\n","\n","            def det(a, b):\n","                return a[0] * b[1] - a[1] * b[0]\n","\n","            div = det(xdiff, ydiff)\n","            if div == 0:\n","                continue\n","            d = (det(*line1), det(*line2))\n","            x = det(d, xdiff) / div\n","            y = det(d, ydiff) / div\n","            if min(line1[0][0], line1[1][0]) <= x <= max(line1[0][0], line1[1][0]) and min(line1[0][1], line1[1][1]) <= y <= max(line1[0][1], line1[1][1]):\n","                if min(line2[0][0], line2[1][0]) <= x <= max(line2[0][0], line2[1][0]) and min(line2[0][1], line2[1][1]) <= y <= max(line2[0][1], line2[1][1]):\n","                    intersections.append((x, y))\n","    return intersections\n","\n","def calculate_levels_and_discrepancy(lines):\n","    levels = defaultdict(int)\n","    for line in lines:\n","        (x1, y1), (x2, y2) = line  # Desempaquetar las coordenadas de inicio y fin de la línea\n","        for x, y in line:  # Iterar sobre los puntos de la línea actual, no sobre todas las líneas\n","            if (x1 < x < x2 and y < y1) or (x1 < x < x2 and y < y2):\n","                levels[(x, y)] += 1\n","    discrepancy = sum(levels.values())\n","    return levels, discrepancy\n","\n","def calculate_distances(intersections, lines):\n","    distances = []\n","    for inter1, inter2 in combinations(intersections, 2):\n","        dist = np.linalg.norm(np.array(inter1) - np.array(inter2))\n","        distances.append((inter1, inter2, dist))\n","    return distances\n","\n","def main():\n