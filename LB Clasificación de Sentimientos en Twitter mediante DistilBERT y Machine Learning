embedding_model_name = \"distilbert-base-uncased\"\n","tokenizer = AutoTokenizer.from_pretrained(embedding_model_name)\n","model = AutoModel.from_pretrained(embedding_model_name)\n","\n","# Función para obtener embeddings de los tweets\n","def extract_embeddings(texts, tokenizer, model):\n","    inputs = tokenizer(texts, padding=True, truncation=True, return_tensors=\"pt\", max_length=128)\n","    with torch.no_grad():\n","        outputs = model(**inputs)\n","    return outputs.last_hidden_state[:, 0, :].numpy()  # Usamos el embedding del token [CLS]\n","\n","# Extraer embeddings para el conjunto de entrenamiento y validación\n","train_embeddings = extract_embeddings(df_train[\"text\"].tolist(), tokenizer, model)\n","valid_embeddings = extract_embeddings(df_valid[\"text\"].tolist(), tokenizer, model)\n","\n","# Obtener etiquetas\n","train_labels = df_train[\"label\"].values\n","valid_labels = df_valid[\"label\"].values\n","\n","# Entrenar modelos de aprendizaje automático\n","models = {\n","    \"Regresión Logística\": LogisticRegression(max_iter=1000),\n","    \"SVM\": SVC(kernel=\"linear\", probability=True),\n","    \"AdaBoost\": AdaBoostClassifier(n_estimators=100)\n","}\n","\n","# Evaluar cada modelo\n","results = {}\n","for name, clf in models.items():\n","    clf.fit(train_embeddings, train_labels)\n","    predictions = clf.predict(valid_embeddings)\n","    accuracy = accuracy_score(valid_labels, predictions)\n","    results[name] = accuracy\n","    print(f\"\\nModelo: {name}\")\n","    print(f\"Exactitud: {accuracy:.4f}\")\n","    print(classification_report(valid_labels, predictions))\n","\n","# Mostrar el mejor modelo\n","best_model = max(results, key=results.get)\n","print(f\"\\nEl mejor modelo es: {best_model} con una exactitud de {results[best_model]:.4f}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":477,"referenced_widgets":["55aefac48b884e60abbb572be384fabd","ad90dc109707422eb2d94e15f8943fc7","8bebd7a656384cd8b01f431943a91