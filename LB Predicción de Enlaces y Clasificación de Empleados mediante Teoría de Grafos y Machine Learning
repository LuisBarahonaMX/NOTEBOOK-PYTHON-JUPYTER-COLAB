, v):\n","    s = 0.0\n","    for w in nx.common_neighbors(G, u, v):\n","        dw = deg.get(w, 0)\n","        if dw > 0:\n","            s += 1.0/dw\n","    return s\n","\n","# Listas para almacenar valores\n","cn_list, j_list, aa_list, ra_list, pa_list, spl_list = [], [], [], [], [], []\n","\n","for u, v in pairs:\n","    if G.has_node(u) and G.has_node(v):\n","        cn = len(list(nx.common_neighbors(G, u, v)))\n","        j  = jaccard(u, v, cn)\n","        aa = adamic_adar(u, v)\n","        ra = resource_alloc(u, v)\n","        pa = deg.get(u, 0) * deg.get(v, 0)\n","        try:\n","            spl = nx.shortest_path_length(G, u, v)\n","        except nx.NetworkXNoPath:\n","            spl = float('inf')\n","    else:\n","        cn = j = aa = ra = pa = 0\n","        spl = float('inf')\n","    cn_list.append(cn)\n","    j_list.append(j)\n","    aa_list.append(aa)\n","    ra_list.append(ra)\n","    pa_list.append(pa)\n","    spl_list.append(spl)\n","\n","# Construir DataFrame de características, alineado con df_fc.index\n","features_edges = pd.DataFrame({\n","    'common_neighbors':  cn_list,\n","    'jaccard_coef':      j_list,\n","    'adamic_adar':       aa_list,\n","    'resource_alloc':    ra_list,\n","    'pref_attachment':   pa_list,\n","    'shortest_path_len': spl_list\n","}, index=df_fc.index)\n","\n","# Vista previa de las características\n","features_edges.head(10)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":363},"id":"TJLh9H__6DBQ","executionInfo":{"status":"ok","timestamp":1746391240031,"user_tz":300,"elapsed":1179,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"85a9ef11-2745-4092-efc3-85fbe4a2b17d"},"id":"TJLh9H__6DBQ","execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["            common_neighbors  jaccard_coef  adamic_adar  resource_alloc  \\\n","(6, 840)                   0             0            0               0   \n","(4, 197)  