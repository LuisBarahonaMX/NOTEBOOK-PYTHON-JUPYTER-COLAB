 características\n","data_edges = df_fc.join(features_edges)\n","\n","# 3. Definir X e y\n","feature_cols = [\n","    'common_neighbors', 'jaccard_coef', 'adamic_adar',\n","    'resource_alloc', 'pref_attachment', 'shortest_path_len'\n","]\n","X = data_edges[feature_cols]\n","y = data_edges['Future Connection']\n","\n","# 4. División estratificada 80-20\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X, y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","# 5. Mostrar tamaños y proporciones\n","print(f\"Tamaño total: {len(X)}\")\n","print(f\"→ Entrenamiento: {len(X_train)}  |  Prueba: {len(X_test)}\\n\")\n","\n","print(\"Distribución en entrenamiento:\")\n","print(y_train.value_counts(normalize=True))\n","print(\"\\nDistribución en prueba:\")\n","print(y_test.value_counts(normalize=True))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yhHJhg38CFWc","executionInfo":{"status":"ok","timestamp":1746391327407,"user_tz":300,"elapsed":479,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"70fd07d8-9fe5-4360-b3a7-9ba157643bf1"},"id":"yhHJhg38CFWc","execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Tamaño total: 366334\n","→ Entrenamiento: 293067  |  Prueba: 73267\n","\n","Distribución en entrenamiento:\n","Future Connection\n","0    0.91993\n","1    0.08007\n","Name: proportion, dtype: float64\n","\n","Distribución en prueba:\n","Future Connection\n","0    0.919937\n","1    0.080063\n","Name: proportion, dtype: float64\n"]}]},{"cell_type":"markdown","source":["##Ajustar HistGradientBoostingClassifier y opcionalmente obtener importancias\n"],"metadata":{"id":"krpZSxx7htbD"},"id":"krpZSxx7htbD"},{"cell_type":"code","source":["# Celda 4: Ajustar HistGradientBoostingClassifier y opcionalmente obtener importancias\n","\n","from sklearn.ensemble import HistGradientBoostingClassifier\n","from sklearn.inspection import permutation_impo