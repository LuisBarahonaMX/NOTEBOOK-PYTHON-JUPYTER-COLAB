on color rojo y mayor grosor\n","nx.draw_networkx_edges(G, pos, edgelist=path_edges, edge_color=\"red\", width=3)\n","\n","plt.title(\"Grafo completo y camino encontrado desde A hasta el nodo seleccionado\", fontsize=18)\n","plt.axis('off')\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"HYXJmnu45ZBg","executionInfo":{"status":"ok","timestamp":1741423872415,"user_tz":300,"elapsed":480,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"357e5025-f9d7-4e1a-94a1-ca9e7736ced1"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Resultado del camino:\n","  Recorrido  SumaTotal\n","0      A->M         48\n","\n","Recorrido: A->M\n","Suma total: 48\n","\n","Nodos del camino: ['A', 'M']\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1200 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]}]}