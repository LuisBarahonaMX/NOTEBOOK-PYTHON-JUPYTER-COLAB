klearn.metrics'\n","from sklearn.metrics import accuracy_score\n","# Importa la función 'confusion_matrix' del módulo 'sklearn.metrics'\n","from sklearn.metrics import confusion_matrix\n","# Importa la biblioteca 'matplotlib.pyplot' con el alias 'plt'\n","import matplotlib.pyplot as plt\n","# Importa el módulo 'animation' y el módulo 'colors' desde la biblioteca 'matplotlib'\n","from matplotlib import animation, colors"]},{"cell_type":"markdown","metadata":{"id":"U6Pq_ayhNfKw"},"source":["## **DATOS DIGITOS**"]},{"cell_type":"markdown","source":["### **PASO 1: OBTEBCIÓN DE LOS DATOS**"],"metadata":{"id":"YgrRSW-KRjc_"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"va5q8-EGL5WR","outputId":"dab56118-702e-4ec5-9ffe-9e0dff9ce365"},"outputs":[{"output_type":"stream","name":"stdout","text":["[[ 0.  0.  5. ...  0.  0.  0.]\n"," [ 0.  0.  0. ... 10.  0.  0.]\n"," [ 0.  0.  0. ... 16.  9.  0.]\n"," ...\n"," [ 0.  0.  1. ...  6.  0.  0.]\n"," [ 0.  0.  2. ... 12.  0.  0.]\n"," [ 0.  0. 10. ... 12.  1.  0.]]\n","[0 1 2 ... 8 9 8]\n"]}],"source":["# Importamos la función 'load_digits' desde la biblioteca scikit-learn\n","from sklearn.datasets import load_digits\n","# Cargamos el conjunto de datos \"Digits\" y devolvemos los datos (X) y las etiquetas (y)\n","data_x_digits, data_y_digits = load_digits(return_X_y=True)\n","print(data_x_digits)\n","print(data_y_digits)"]},{"cell_type":"markdown","source":["### **PASO 2: DIVISIÓN DE LOS DATOS**"],"metadata":{"id":"Vk0okM9WRo4-"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lPtYhKHBL5WS","outputId":"42c351c4-0c13-46b7-e52d-862b51ac1567"},"outputs":[{"output_type":"stream","name":"stdout","text":["(1257, 64) (1257,) (540, 64) (540,)\n"]}],"source":["train_x_digits, test_x_digits, train_y_digits, test_y_digits = train_test_split(data_x_digits, data_y_digits, test_size=0.3, random_state=2)\n","print(train_x_digits.shape, train_y_digits.shape, test_x_digits.shape, test_y_digits.shape)"]},{"cell_type":"markdown","source":["### **PASO 3: CREACIÓN DE FUNCIONES**"],"metadata":{"id":"zB1lNVPVTrWD"}},{"cell_type":"code","execution_count":null,"metadata":{"id":"lTek0ZjGL5WS"},"outputs":[],"source":["# Normalización de datos\n","def normalizacion(data):\n","  escalar = MinMaxScaler()\n","  escalado = escalar.fit_transform(data)\n","  return escalado"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ff_SnHyAL5WT"},"outputs":[],"source":["# Distancia Euclideana\n","def dist_Euclideana(x,y):\n","  return distance.euclidean(x,y)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"cPs0oHWIL5WT"},"outputs":[],"source":["# Distancia de Manhattan\n","def dist_Manhattan(x,y):\n","  return distance.cityblock(x,y)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"xrkRDCJaL5WT"},"outputs":[],"source":["# Buscamos la neurona ganadora dentro del mapa (som)\n","# Best Matching Unit search (BMUS)\n","# t = indice de muestra aleatoria de entrenamiento\n","def BMUS(data, t, som):\n","  ganadora = [0,0]\n","  # Inicializa con la distancia más grande\n","  dist_mascorta = np.sqrt(data.shape[1])\n","  # Distancia más corta de la muestra con los valores en el mapa\n","  for row in range(som.shape[0]):\n","    for col in range(som.shape[1]):\n","      # Calcula la distancia Euclideana\n","      distancia = dist_Euclideana(som[row][col], data[t])\n","      # Checa si encontro una distancia más corta\n","      if distancia < dist_mascorta:\n","        # Actualiza la distancia más corta\n","        dist_mascorta = distancia\n","        # Coordenadas de la celda\n","        ganadora = [row,col]\n","  # Regresa las coordenadas de la celda\n","  return ganadora"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"RZzz_-IZL5WU"},"outputs":[],"source":["# Tasa de aprendizaje y rango de vecindad\n","def decaimiento(iter, max_iters, max_tasa_aprendizaje, max_m_distancia):\n","  coeficiente = 1.0 - (np.float64(iter) / max_iters)\n","  tasa_aprendizaje = coeficiente * max_tasa_aprendizaje\n","  rango_vecindario = ceil(coeficiente * max_m_distancia)\n","  return tasa_aprendizaje, rango_vecindario"]},{"cell_type":"markdown","source":["### **PASO 4: INICIALIZACIÓN DEL SOM Y NORMALIZACIÓN**"],"metadata":{"id":"KPP8q-nHUIu4"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"25Ei6UpML5WU","outputId":"4546124a-7978-4551-8ada-6e152d49fe54"},"outputs":[{"output_type":"stream","name":"stdout","text":["mínimo:  0.0\n","máximo:  1.0\n"]}],"source":["# Normalización de datos de entrenamiento\n","train_x_norm_digits = normalizacion(train_x_digits)\n","print(\"mínimo: \", np.min(train_x_norm_digits))\n","print(\"máximo: \", np.max(train_x_norm_digits))"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nlTQ54EOL5WV","outputId":"01ec0c30-9125-47ea-92d8-0bfd3e5e1264"},"outputs":[{"output_type":"stream","name":"stdout","text":["64\n"]}],"source":["# Initialización SOM\n","# Número de dimensiones en los datos de entrada\n","num_dims_digits = train_x_norm_digits.shape[1]\n","print(num_dims_digits)\n","np.random.seed(7)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"XL1Zs8v1L5WX"},"outputs":[],"source":["# Hiperparametros\n","num_filas_digits = 10\n","num_cols_digits = 10\n","max_m_distancia_digits = 4\n","max_tasa_aprendizaje_digits = 0.5\n","max_iters_digits = int(5*10e3) #50000"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rddoSZNZL5WX","outputId":"bdbea405-6a38-4cee-c293-0ac511536770"},"outputs":[{"output_type":"stream","name":"stdout","text":["SOM con dimensiones de:  (10, 10, 64)\n","El valor mínimo es de 0.00011425193750191909,         y \n","el valor máximo es de 0.9998360454174776\n"]}],"source":["# Construcción de SOM\n","# Pesos aleatori