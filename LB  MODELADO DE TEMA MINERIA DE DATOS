,"metadata":{"id":"lK6ncUtyx2DZ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from sklearn.cluster import KMeans\n","\n","# Convertir la columna de embeddings en una matriz numpy\n","import numpy as np\n","X = np.vstack(df[\"embeddings\"].values)\n","\n","# Seleccionar el número óptimo de clusters con el método del codo\n","import matplotlib.pyplot as plt\n","from sklearn.metrics import silhouette_score\n","\n","wcss = []\n","silhouette_scores = []\n","k_range = range(2, 10)  # Probar de 2 a 10 clusters\n","\n","for k in k_range:\n","    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n","    kmeans.fit(X)\n","    wcss.append(kmeans.inertia_)\n","    silhouette_scores.append(silhouette_score(X, kmeans.labels_))\n","\n","# Graficar el método del codo\n","plt.figure(figsize=(8, 4))\n","plt.plot(k_range, wcss, marker=\"o\", linestyle=\"--\")\n","plt.xlabel(\"Número de Clusters (k)\")\n","plt.ylabel(\"WCSS (Within-Cluster Sum of Squares)\")\n","plt.title(\"Método del Codo para determinar k\")\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":411},"id":"4lKYLAe6yVuc","executionInfo":{"status":"ok","timestamp":1740935219117,"user_tz":300,"elapsed":7619,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"ce0ecd0b-7148-4e76-e0c3-df13f263aa67"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["from collections import Counter\n","from wordcloud import WordCloud\n","\n","# Aplicar K-Means con el mejor k encontrado\n","optimal_k = k_range[np.argmin(wcss)]  # O seleccionar el mejor basado en silhouette_score\n","kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n","df[\"cluster\"] = kmeans.fit_predict(X)\n","\n","# Generar nubes de palabras por cada cluster\n","for cluster in range(optimal_k):\n","    # Access the 