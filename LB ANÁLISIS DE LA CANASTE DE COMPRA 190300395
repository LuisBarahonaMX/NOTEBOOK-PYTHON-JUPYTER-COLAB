compra y generar reglas de asociación significativas.\n"],"metadata":{"id":"x1RlThWLa_oA"}}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMHRvEJwyUib+n5j7rmovEs"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}