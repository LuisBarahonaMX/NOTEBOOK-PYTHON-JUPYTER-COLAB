 que contienen X\n","    freq_XY = sum(1 for trans in T if X.issubset(trans) and Y.issubset(trans))  # Número de transacciones que contienen X e Y\n","\n","    # Retorna la confianza: freq_XY / freq_X\n","    if freq_X > 0:\n","        return freq_XY / freq_X\n","    else:\n","        return 0\n"],"metadata":{"id":"tli7mbk4MHhk"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["T = [\n","    {'PAPER CRAFTS, SMALL LITTLE BIRD', 'MEDIUM STORAGE JAR WITH CERAMIC LID', 'WWII-ASSISTED GLIDER DESIGNS', 'JUMBO RED RETROSPOT BAG'},\n","    {'PAPER CRAFTS, SMALL LITTLE BIRD', 'MEDIUM STORAGE JAR WITH CERAMIC LID', 'JUMBO RED RETROSPOT BAG'},\n","    {'WWII-ASSISTED GLIDER DESIGNS', 'JUMBO RED RETROSPOT BAG'},\n","    {'PAPER CRAFTS, SMALL LITTLE BIRD', 'WWII-ASSISTED GLIDER DESIGNS'}\n","]\n"],"metadata":{"id":"MdPQu8m1MN1c"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","conf_min = 0.6\n","\n","# R1\n","X = set(['PAPER CRAFTS, SMALL LITTLE BIRD', 'MEDIUM STORAGE JAR WITH CERAMIC LID', 'WWII-ASSISTED GLIDER DESIGNS'])\n","Y = set(['JUMBO RED RETROSPOT BAG'])\n","if confianza(X, Y, T) > conf_min:\n","    print(f\"{X} ===> {Y}\")\n","\n","# R2\n","X = set(['PAPER CRAFTS, SMALL LITTLE BIRD', 'MEDIUM STORAGE JAR WITH CERAMIC LID', 'JUMBO RED RETROSPOT BAG'])\n","Y = set(['WWII-ASSISTED GLIDER DESIGNS'])\n","if confianza(X, Y, T) > conf_min:\n","    print(f\"{X} ===> {Y}\")\n","\n","# R3\n","X = set(['PAPER CRAFTS, SMALL LITTLE BIRD', 'WWII-ASSISTED GLIDER DESIGNS', 'JUMBO RED RETROSPOT BAG'])\n","Y = set(['MEDIUM STORAGE JAR WITH CERAMIC LID'])\n","if confianza(X, Y, T) > conf_min:\n","    print(f\"{X} ===> {Y}\")\n","\n","# R4\n","conf_min = 0.8\n","# R1\n","X = set(['PAPER CRAFTS, SMALL LITTLE BIRD', 'MEDIUM STORAGE JAR WITH CERAMIC LID', 'WWII-ASSISTED GLIDER DESIGNS'])\n","Y = set(['JUMBO RED RETROSPOT BAG'])\n","if confianza(X, Y, T) > conf_min:\n","    print(f\"{X} ===> {Y}\")\n","\n","# R2\n","X = set(['PAPER CRAFTS, SMALL LITT