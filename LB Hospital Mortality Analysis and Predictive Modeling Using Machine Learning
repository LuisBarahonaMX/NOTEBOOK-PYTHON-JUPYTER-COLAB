75</sub> ; 0 si NUMERO DE PACIENTES &lt; Q<sub>0.75</sub> }\n","      </em>\n","    </li>\n","  </ul>\n","  <p>\n","\n","  </p>\n","</div>\n"],"metadata":{"id":"yrzQTggnaWU7"}},{"cell_type":"code","source":["# Filtrar el DataFrame para quedarnos solo con las columnas de interés\n","df_modelo = df[['AÑO', 'C.I.E.10', 'MORTALIDAD', 'NUMERO DE PACIENTES']].copy()\n","\n","# Definir el umbral para alta mortalidad (por ejemplo, el percentil 75)\n","umbral = df_modelo['NUMERO DE PACIENTES'].quantile(0.75)\n","\n","# Crear la variable objetivo: 1 si el número de pacientes es mayor o igual al umbral, 0 en caso contrario\n","df_modelo['ALTA_MORTALIDAD'] = (df_modelo['NUMERO DE PACIENTES'] >= umbral).astype(int)\n","\n","print(\"Umbral para alta mortalidad:\", umbral)\n","display(df_modelo.head())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":246},"id":"LjLCbK9G4vw2","executionInfo":{"status":"ok","timestamp":1741250336766,"user_tz":300,"elapsed":42,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"9bd2db66-dd12-4350-eba0-244813515a63"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Umbral para alta mortalidad: 2.0\n"]},{"output_type":"display_data","data":{"text/plain":["    AÑO C.I.E.10                           MORTALIDAD  NUMERO DE PACIENTES  \\\n","0  2013     J189                             Neumonía                   87   \n","1  2013     A419                               Sepsis                   42   \n","2  2013     I219          Infarto agudo del miocardio                   16   \n","3  2013     P369  Sepsis bacteriana del recién nacido                   14   \n","4  2013     K729               Insuficiencia hepática                   10   \n","\n","   ALTA_MORTALIDAD  \n","0                1  \n","1                1  \n","2                1  \n","3                1  \n","4                1  "],"text/html":["\n","  <div id=\"df-fda91c14-22cd-499d-87a4-d22136c4