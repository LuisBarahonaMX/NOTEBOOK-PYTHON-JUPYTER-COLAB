nnels, out_channels):\n","        super().__init__()\n","        # Define the graph convolution layers\n","        self.conv1 = GCNConv(in_channels, hidden_channels)\n","        self.conv2 = GCNConv(hidden_channels, out_channels)\n","\n","    def forward(self, data):\n","        # Perform forward pass\n","        x, edge_index = data.x, data.edge_index\n","        x = self.conv1(x, edge_index)\n","        x = F.relu(x) # Apply ReLU activation\n","        x = F.dropout(x, training=self.training) # Apply dropout for regularization\n","        x = self.conv2(x, edge_index)\n","        return F.log_softmax(x, dim=1) # Apply log_softmax for output probabilities\n","\n","in_channels = data.num_node_features\n","hidden_channels = 16 # You can adjust this hyperparameter\n","out_channels = 2     # Binary classification: 0 or 1\n","\n","model = GCN(in_channels=in_channels, hidden_channels=hidden_channels, out_channels=out_channels)\n","\n","print(model) # Print the model structure"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"woPUZyz4AmN5","executionInfo":{"status":"ok","timestamp":1747498199564,"user_tz":300,"elapsed":9,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"92ca848f-5e34-407b-c29c-293ba75b6dfc"},"id":"woPUZyz4AmN5","execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["GCN(\n","  (conv1): GCNConv(3, 16)\n","  (conv2): GCNConv(16, 2)\n",")\n"]}]},{"cell_type":"code","source":["train_losses = []\n","train_accs = []\n","test_accs = []\n","\n","optimizer = torch.optim.Adam(model.parameters(), lr=0.01, weight_decay=5e-4)\n","\n","for epoch in range(1, 201):\n","    # Entrenamiento\n","    model.train()\n","    optimizer.zero_grad()\n","    out = model(data)\n","    # Use NLLLoss with log_softmax output from the model\n","    loss = F.nll_loss(out[data.train_mask], data.y[data.train_mask])\n","    loss.backward()\n","    optimizer.step()\n","\n","    train_losses.append(loss.item())\n","\n","    # Evaluación por época\n","    model.eval()\n","    with torch.no_grad():\n","        logits = model(data)\n","        # Get the predicted class by taking the index with the maximum log-probability\n","        preds = logits.argmax(dim=1)\n","\n","    train_accs.append((preds[data.train_mask] == data.y[data.train_mask]).float().mean().item())\n","    test_accs.append((preds[data.test_mask]  == data.y[data.test_mask] ).float().mean().item())\n","\n","# Plot pérdida\n","plt.figure()\n","plt.plot(train_losses)\n","plt.title(\"Curva de Pérdida (GCN)\")\n","plt.xlabel(\"Época\")\n","plt.ylabel(\"Pérdida\")\n","plt.show()\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":474},"id":"1Hs7D31nDtA5","executionInfo":{"status":"ok","timestamp":1747498239112,"user_tz":300,"elapsed":2572,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"b411c77b-f719-4594-ffd6-f6c26abaf384"},"id":"1Hs7D31nDtA5","execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["##Accuracy por EPoca (GCN)"],"metadata":{"id":"n1rNIDGvA5A8"},"id":"n1rNIDGvA5A8"},{"cell_type":"code","source":["# Plot accuracy\n","plt.figure()\n","plt.plot(train_accs)\n","plt.plot(test_accs)\n","plt.title(\"Accuracy por Época (GCN)\")\n","plt.xlabel(\"Época\")\n","plt.ylabel(\"Accuracy\")\n","plt.legend([\"Train\", \"Test\"])\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":476},"id":"7ZE7W-RjAxlB","executionInfo":{"status":"ok","timestamp":1747498247108,"user_tz":300,"elapsed":633,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"fe69c342-be60-4594-b87b-e7c4ee005c4b"},"id":"7ZE7W-RjAxlB","execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#Regresión Logística con PyTorch\n","##Entrenamiento y visualización de curvas de aprendizaje de un GCN\n","\n","La celda define un modelo de Red de Convolución de Grafo (GCN) con dos capas, configurando las dimensiones de entrada, ocultas y de salida para clasificación binaria; luego entrena el modelo durante 200 épocas usando Adam y NLLLoss, registrando en cada paso la pérdida y las precisiones en los conjuntos de entrenamiento y prueba. Finalmente, traza dos gráficas: la curva de pérdida a lo largo de las épocas y la evolución de la precisión (train vs. test), permitiendo evaluar visualmente el aprendizaje y la generalización del GCN."],"metadata":{"id":"DwtXUUuKBtXi"},"id":"DwtXUUuKBtXi"},{"cell_type":"code","source":["baseline = torch.nn.Linear(data.num_node_features, 1)\n","opt_base = torch.optim.Adam(baseline.parameters(), lr=0.01)\n","criterion = torch.nn.BCEWithLogitsLoss()\n","\n","y_float = data.y.float().unsqueeze(1)\n","\n","# Entrenamiento del baseline\n","for epoch in range(1, 101):\n","    baseline.train()\n","    opt_base.zero_grad()\n","    logits_base = baseline(data.x)\n","    loss_base = criterion(logits_base[data.train_mask], y_float[data.train_mask])\n","    loss_base.backward()\n","    opt_base.step()\n","\n","# Evaluación del baseline\n","baseline.eval()\n","with torch.no_grad():\n","    logits_base = baseline(data.x)\n","    probs_base  = torch.sigmoid(logits_base).squeeze()\n","    preds_base  = (probs_base >= 0.5).long()\n","\n","train_acc_base = (preds_base[data.train_mask] == data.y[data.train_mask]).float().mean().item()\n","test_acc_base  = (preds_base[data.test_mask]  == data.y[data.test_mask] ).float().mean().item()\n","\n","# AUC-ROC manual\n","import numpy as np\n","y_true = data.y[data.test_mask].cpu().numpy()\n","y_score = probs_base[data.test_mask].cpu().numpy()\n","idx_desc = np.argsort(-y_score)\n","y_true_sorted = y_true[idx_desc]\n","tps = np.concatenate([[0], np.cumsum(y_true_sorted)])\n","fps = np.concatenate([[0], np.cumsum(1 - y_true_sorted)])\n","tpr = tps / tps[-1]\n","fpr = fps / fps[-1]\n","auc_base = np.trapz(tpr, fpr)\n","\n","print(f\"Baseline Train Acc: {train_acc_base:.4f}\")\n","print(f\"Baseline Test  Acc: {test_acc_base:.4f}\")\n","print(f\"Baseline Test  AUC: {auc_base:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_cdBMkxVD7Sy","executionInfo":{"status":"ok","timestamp":1747498304304,"user_tz":300,"elapsed":132,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"24ca948c-8961-4438-fcee-79b598b7870a"},"id":"_cdBMkxVD7Sy","execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Baseline Train Acc: 0.8488\n","Baseline Test  Acc: 0.8146\n","Baseline Test  AUC: 0.2695\n"]},{"output_type":"stream","name":"stderr","text":["<ipython-input-41-8a4767e348db>:39: DeprecationWarning: `trapz` is deprecated. Use `trapezoid` instead, or one of the numerical integration functions in `scipy.integrate`.\n","  auc_base = np.trapz(tpr, fpr)\n"]}]},{"cell_type":"code","source":["uv = (\n","    fc['Unnamed: 0']\n","    .str.strip('()')\n","    .str.replace(' ', '')\n","    .str.split(',', expand=True)\n","    .astype(int)\n",")\n","uv.columns = ['u', 'v']\n","fc2 = pd.concat([uv, fc['Future Connection'].astype(int)], axis=1)\n","\n","pairs  = list(zip(fc2['u'], fc2['v']))\n","labels = fc2['Future Connection'].tolist()\n"],"metadata":{"id":"hAOovII0KX3q"},"id":"hAOovII0KX3q","execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["##Extrae embeddings desde la capa conv1 de tu GCN"],"metadata":{"id":"sKUoZQq5CA_8"},"id":"sKUoZQq5CA_8"},{"cell_type":"code","source":["\n","model.eval()\n","with torch.no_grad():\n","    hidden = F.relu(model.conv1(data.x, data.edge_index))  # [N, H]\n","x\n","id2idx = {nid: i for i, nid in enumerate(node_ids)}\n","X = []\n","y = []\n","for (u, v), lab in zip(pairs, labels):\n","    if u in id2idx