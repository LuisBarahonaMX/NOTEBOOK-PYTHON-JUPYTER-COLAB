erta2\"].fillna(0)\n","if \"bajadas_total\" not in d.columns:\n","    d[\"bajadas_total\"] = d[\"BajadasPuerta1\"].fillna(0) + d[\"BajadasPuerta2\"].fillna(0)\n","d[\"mov\"] = d[\"subidas_total\"] + d[\"bajadas_total\"]\n","\n","orden_dias = [\"Lunes\",\"Martes\",\"Miércoles\",\"Jueves\",\"Viernes\",\"Sábado\",\"Domingo\"]\n","\n","dow_month = (d.groupby([\"dia_semana_es\",\"anio_mes\"], as_index=False)[\"mov\"].sum()\n","             .pivot(index=\"dia_semana_es\", columns=\"anio_mes\", values=\"mov\")\n","             .reindex(orden_dias)\n","             .fillna(0))\n","\n","# ordenar meses cronológicamente\n","cols_sorted = sorted(dow_month.columns, key=lambda x: pd.to_datetime(x + \"-01\"))\n","dow_month = dow_month[cols_sorted]\n","\n","plt.figure(figsize=(12,4))\n","plt.imshow(dow_month.values, aspect=\"auto\", origin=\"upper\")\n","plt.title(\"Heatmap: Movimiento por Día de la Semana × Mes\")\n","plt.xlabel(\"Mes\")\n","plt.ylabel(\"Día de la semana\")\n","plt.xticks(np.arange(len(dow_month.columns)), dow_month.columns, rotation=45, ha=\"right\")\n","plt.yticks(np.arange(len(orden_dias)), orden_dias)\n","plt.colorbar(label=\"Movimiento total\")\n","plt.show()\n","\n","dow_month"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"KZnyfwYSitjd","executionInfo":{"status":"ok","timestamp":1772811953298,"user_tz":300,"elapsed":4237,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"857b7da8-7527-474f-cdaa-980a4cb007a7"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"execute_result","data":{"text/plain":["anio_mes       2025-08  2025-09  2025-10  2025-11  2025-12  2026-01  2026-02\n","dia_semana_es                                                               \n","Lunes             5177    12710    12020    10374    13445    10667     4458\n","Martes            6603    13451    114