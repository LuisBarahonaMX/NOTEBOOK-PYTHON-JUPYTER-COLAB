    if row.empty:\n","            print(\"No hay datos para el mes:\", mes)\n","            return\n","\n","        sub = float(row[\"subidas\"].iloc[0])\n","        baj = float(row[\"bajadas\"].iloc[0])\n","        mov = float(row[\"mov\"].iloc[0])\n","        bal = float(row[\"balance\"].iloc[0])\n","        dias = int(row[\"dias\"].iloc[0])\n","\n","        mes_txt = etiqueta_mes(mes)\n","\n","        print(f\"Resumen {mes_txt} | días con datos: {dias}\")\n","        print(f\"Subidas: {int(sub)} | Bajadas: {int(baj)} | Mov: {int(mov)} | Balance neto: {int(bal)}\")\n","\n","        # Barras del mes\n","        labels = [\"Subidas\", \"Bajadas\", \"Mov\", \"Balance\"]\n","        values = [sub, baj, mov, bal]\n","\n","        plt.figure()\n","        plt.bar(labels, values)\n","        plt.title(f\"Demanda de pasajeros - {mes_txt}\")\n","        plt.ylabel(\"Total del mes\")\n","        plt.grid(True, axis=\"y\")\n","        plt.show()\n","\n","        # Serie diaria del mes\n","        dfm = df[df[\"anio_mes\"] == mes].dropna(subset=[\"FechaHora\"]).copy()\n","        daily = (dfm.groupby(\"fecha\", as_index=False)\n","                   .agg(mov=(\"mov\",\"sum\"), subidas=(\"subidas_total\",\"sum\"), bajadas=(\"bajadas_total\",\"sum\")))\n","        daily[\"fecha\"] = pd.to_datetime(daily[\"fecha\"])\n","        daily = daily.sort_values(\"fecha\")\n","\n","        plt.figure()\n","        plt.plot(daily[\"fecha\"], daily[\"mov\"])\n","        plt.title(f\"Serie diaria (movimiento) - {mes_txt}\")\n","        plt.xlabel(\"Fecha\")\n","        plt.ylabel(\"Mov (subidas + bajadas)\")\n","        plt.grid(True)\n","        plt.show()\n","\n","def on_change(change):\n","    if change[\"type\"] == \"change\" and change[\"name\"] == \"value\":\n","        plot_mes(change[\"new\"])\n","\n","dropdown.observe(on_change)\n","\n","display(dropdown, out)\n","plot_mes(dropdown.value)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":906,"referenced_widgets":["be273532bdea43d4adb5f9f313643f76","b966eade5e4841a4a6ba43acb24b08dc","418a00bd16c3422db4a5a4f2a7fbf54a","420a5136f53547439dae49168af38e2b","15442f891f734666a9c22e8997253d21"]},"id":"D3cjPR9-ZWl1","executionInfo":{"status":"ok","timestamp":1772811903561,"user_tz":300,"elapsed":1923,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"0a22f5db-bf35-4e98-ca0e-2018536fccf3"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Dropdown(description='Mes:', options=(('Agosto 2025', '2025-08'), ('Septiembre 2025', '2025-09'), ('Octubre 20…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"be273532bdea43d4adb5f9f313643f76"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["Output()"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"420a5136f53547439dae49168af38e2b"}},"metadata":{}}]},{"cell_type":"markdown","source":["## Celda: Patrones temporales (serie diaria, horas pico 0-23, día de semana, comparación por quincenas)\n"," Requiere: df con FechaHora ya parseado, y columnas subidas_total, bajadas_total, mov, anio_mes, fecha, hora_24.\n"," Si no tienes hora_24, la creamos.\n"],"metadata":{"id":"0PQqj7cNbOPe"}},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Asegurar columnas necesarias\n","df[\"FechaHora\"] = pd.to_datetime(df[\"FechaHora\"], errors=\"coerce\")\n","df = df.dropna(subset=[\"FechaHora\"]).copy()\n","\n","df[\"fecha\"] = df[\"FechaHora\"].dt.date\n","df[\"fecha_dt\"] = pd.to_datetime(df[\"fecha\"])\n","df[\"hora_24\"] = df[\"FechaHora\"].dt.hour\n","df[\"anio_mes\"] = df[\"FechaHora\"].dt.to_period(\"M\").astype(str)\n","df[\"dia_semana\"] = df[\"FechaHora\"].dt.day_name()  # Inglés por defecto\n","\n","# Etiquetas de días en español (para gráficas)\n","map_dias = {\n","    \"Monday\":\"Lunes\",\"Tuesday\":\"Martes\",\"Wednesday\":\"Miércoles\",\"Thursday\":\"Jueves\",\n","    \"Friday\":\"Viernes\",\"Saturday\":\"Sábado\",\"Sunday\":\"Domingo\"\n","}\n","df[\"dia_semana_es\"] = df[\"dia_semana\"].map(map_dias)\n","\n","# Asegurar mov si no existe\n","if \"subidas_total\" not in df.columns:\n","    df[\"subidas_total\"] = df[\"SubidasPuerta1\"].fillna(0) + df[\"SubidasPuerta2\"].fillna(0)\n","if \"bajadas_total\" not in df.columns:\n","    df[\"bajadas_total\"] = df[\"BajadasPuerta1\"].fillna(0) + df[\"BajadasPuerta2\"].fillna(0)\n","df[\"mov\"] = df[\"subidas_total\"] + df[\"bajadas_total\"]\n","\n","# ---------- 1) Serie diaria (global) ----------\n","daily_global = (df.groupby(\"fecha_dt\", as_index=False)\n","                  .agg(mov=(\"mov\",\"sum\"),\n","                       subidas=(\"subidas_total\",\"sum\"),\n","                       bajadas=(\"bajadas_total\",\"sum\"))).sort_values(\"fecha_dt\")\n","\n","plt.figure()\n","plt.plot(daily_global[\"fecha_dt\"], daily_global[\"mov\"])\n","plt.title(\"Serie diaria global: movimiento (subidas + bajadas)\")\n","plt.xlabel(\"Fecha\")\n","plt.ylabel(\"Movimiento\")\n","plt.grid(True)\n","plt.show()\n","\n","# Top 10 picos y top 10 caídas (mínimos)\n","top10_picos = daily_global.sort_values(\"mov\", ascending=False).head(10)\n","top10_caidas = daily_global.sort_values(\"mov\", ascending=True).head(10)\n","\n","print(\"Top 10 días con más movimiento:\")\n","display(top10_picos)\n","\n","print(\"Top 10 días con menos movimiento:\")\n","display(top10_caidas)\n","\n","# ---------- 2) Horas pico (0-23) global ----------\n","by_hour = (df.groupby(\"hora_24\", as_index=False)\n","             .agg(mov=(\"mov\",\"sum\"),\n","                  subidas=(\"subidas_total\",\"sum\"),\n","                  bajadas=(\"bajadas_total\",\"sum\"))).sort_values(\"hora_24\")\n","\n","plt.figure()\n","plt.bar(by_hour[\"hora_24\"], by_hour[\"mov\"])\n","plt.title(\"Horas pico global (0–23): movimiento total\")\n","plt.xlabel(\"Hora del día (24h)\")\n","plt.ylabel(\"Movimiento\")\n","plt.xticks(range(0,24))\n","plt.grid(True, axis=\"y\")\n","plt.show()\n","\n","print(\"Top 10 horas pico globales:\")\n","display(by_hour.sort_values(\"mov\", ascending=False).head(10))\n","\n","# ---------- 3) Día de la semana (lunes-domingo) ----------\n","orden_dias = [\"Lunes\",\"Martes\",\"Miércoles\",\"Jueves\",\"Viernes\",\"Sábado\",\"Domingo\"]\n","\n","by_dow = (df.groupby(\"dia_semana_es\", as_index=False)\n","            .agg(mov=(\"mov\",\"sum\"),\n","                 subidas=(\"subidas_total\",\"sum\"),\n","                 bajadas=(\"bajadas_total\",\"sum\")))\n","\n","by_dow[\"dia_semana_es\"] = pd.Categorical(by_dow[\"dia_semana_es\"], categories=orden_dias, ordered=True)\n","by_dow = by_dow.sort_values(\"dia_semana_es\")\n","\n","plt.figure()\n","plt.bar(by_dow[\"dia_semana_es\"].astype(str), by_dow[\"mov\"])\n","plt.title(\"Demanda por día de la semana (global)\")\n","plt.xlabel(\"Día\")\n","plt.ylabel(\"Movimiento total\")\n","plt.grid(True, axis=\"y\")\n","plt.show()\n","\n","display(by_dow)\n","\n","# ---------- 4) Comparación por semanas / quincenas ----------\n","# a) Semana ISO (útil para ver tendencia)\n","df[\"iso_year\"] = df[\"FechaHora\"].dt.isocalendar().year.astype(int)\n","df[\"iso_week\"] = df[\"FechaHora\"].dt.isocalendar().week.astype(int)\n","df[\"year_week\"] = df[\"iso_year\"].astype(str) + \"-W\" + df[\"iso_week\"].astype(str).str.zfill(2)\n","\n","weekly = (df.groupby(\"year_week\", as_index=False)\n","            .agg(mov=(\"mov\",\"sum\"),\n","                 subidas=(\"subidas_total\",\"sum\"),\n","                 bajadas=(\"bajadas_total\",\"sum\")))\n","\n","# Para ordenarlo cronológicamente, creamos una clave numérica\n","weekly[\"week_key\"] = weekly[\"year_week\"].str.replace(\"-W\",\"\").str.replace(\"-\", \"\").astype(int)\n","weekly = weekly.sort_values(\"week_key\").drop(columns=[\"week_key\"])\n","\n","plt.figure()\n","plt.bar(weekly[\"year_week\"], weekly[\"mov\"])\n","plt.title(\"Movimiento por semana (global)\")\n","plt.xlabel(\"Semana (ISO)\")\n","plt.ylabel(\"Movimiento\")\n","plt.xticks(rotation=45, ha=\"right\")\n","plt.grid(True, axis=\"y\")\n","plt.show()\n","\n","# b) Quincenas dentro de cada mes (1-15 / 16-fin)\n","df[\"quincena\"] = np.where(df[\"FechaHora\"].dt.day <= 15, \"01-15\", \"16-fin\")\n","df[\"mes_quincena\"] = df[\"anio_mes\"] + \" (\" + df[\"quincena\"] + \")\"\n","\n","quincenal = (df.groupby(\"mes_quincena\", as_index=False)\n","               .agg(mov=(\"mov\",\"sum\"),\n","                    subidas=(\"subidas_total\",\"sum\"),\n","                    bajadas=(\"bajadas_total\",\"sum\"),\n","                    dias=(\"fecha\", \"nunique\")))\n","\n","# Orden cronológico por (anio_mes, quincena)\n","quincenal[\"anio_mes_dt\"] = pd.to_datetime(quincenal[\"mes_quincena\"].str.extract(r\"(\\d{4}-\\d{2})\")[0] + \"-01\")\n","quincenal[\"q_order\"] = quincenal[\"mes_quincena\"].str.contains(r\"\\(16-fin\\)\").astype(int)\n","quincenal = quincenal.sort_values([\"anio_mes_dt\",\"q_order\"]).drop(columns=[\"anio_mes_dt\",\"q_order\"])\n","\n","plt.figure()\n","plt.bar(quincenal[\"mes_quincena\"], quincenal[\"mov\"])\n","plt.title(\"Comparación por quincenas (dentro de cada mes)\")\n","plt.xlabel(\"Mes (quincena)\")\n","plt.ylabel(\"Movimiento\")\n","plt.xticks(rotation=45, ha=\"right\")\n","plt.grid(True, axis=\"y\")\n","plt.show()\n","\n","display(quincenal)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"YaN-KJf-bEV1","executionInfo":{"status":"ok","timestamp":1772811915676,"user_tz":300,"elapsed":12114,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"2e049a3a-afaa-45e8-af03-d6543d83ff1e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Top 10 días con más movimiento:\n