 \"subidas\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 6987,\n        \"min\": 1487,\n        \"max\": 30664,\n        \"num_unique_values\": 13,\n        \"samples\": [\n          20949,\n          18571,\n          1487\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"bajadas\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 7239,\n        \"min\": 1630,\n        \"max\": 31809,\n        \"num_unique_values\": 13,\n        \"samples\": [\n          21007,\n          19605,\n          1630\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"dias\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2,\n        \"min\": 9,\n        \"max\": 16,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          16,\n          10,\n          9\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","source":["## Celda: Selector de mes + (1) Tiempo activo por día (primer vs último) (2) Días con movimiento 0\n","### Requiere: df con FechaHora parseado y columna mov (si no existe, se crea)."],"metadata":{"id":"8woV8gWfcey2"}},{"cell_type":"code","source":["\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import ipywidgets as widgets\n","from IPython.display import display, clear_output\n","\n","# --- Asegurar campos base ---\n","df[\"FechaHora\"] = pd.to_datetime(df[\"FechaHora\"], errors=\"coerce\")\n","dfm_base = df.dropna(subset=[\"FechaHora\"]).copy()\n","\n","dfm_base[\"anio_mes\"] = dfm_base[\"FechaHora\"].dt.to_period(\"M\").astype(str)\n","dfm_base[\"fecha\"] = dfm_base[\"FechaHora\"].dt.date\n","\n","# Asegurar mov\n","if \"subidas_total\" not in dfm_base.columns:\n","    dfm_base[\"subidas_total\"] = dfm_base[\"SubidasPuerta1\"].fillna(0) + dfm_base[\"SubidasPuerta2\"].fillna(0)\n","if \"bajadas_total\" not in dfm_base.columns:\n","    dfm_base[\"bajadas_total\"] = dfm_base[\"BajadasPuerta1\"].fillna(0) + dfm_base[\"BajadasPuerta2\"].fillna(0)\n","dfm_base[\"mov\"] = dfm_base[\"subidas_total\"] + dfm_base[\"bajadas_total\"]\n","\n","# Etiquetas bonitas para meses\n","def etiqueta_mes(ym_str):\n","    dt = pd.to_datetime(ym_str + \"-01\")\n","    meses_es = {1:\"Enero\",2:\"Febrero\",3:\"Marzo\",4:\"Abril\",5:\"Mayo\",6:\"Junio\",\n","                7:\"Julio\",8:\"Agosto\",9:\"Septiembre\",10:\"Octubre\",11:\"Noviembre\",12:\"Diciembre\"}\n","    return f\"{meses_es[dt.month]} {dt.year}\"\n","\n","meses_internos = sorted(dfm_base[\"anio_mes\"].dropna().unique().tolist(), key=lambda x: pd.to_datetime(x + \"-01\"))\n","opciones_dropdown = [(etiqueta_mes(m), m) for m in meses_internos]\n","\n","dropdown = widgets.Dropdown(\n","    options=opciones_dropdown,\n","    value=meses_internos[0] if len(meses_internos) > 0 else None,\n","    description=\"Mes:\",\n","    disabled=False\n",")\n","\n","out = widgets.Output()\n","\n","def plot_tiempo_activo_y_ceros(mes):\n","    with out:\n","        clear_output(wait=True)\n","        mes_txt = etiqueta_mes(mes)\n","\n","        dfm = dfm_base[dfm_base[\"anio_mes\"] == mes].copy()\n","        if dfm.empty:\n","            print(\"No hay datos para:\", mes_txt)\n","            return\n","\n","        # --- 1) Tiempo activo por día y dispositivo ---\n","        active = (dfm.groupby([\"Dispositivo\",\"fecha\"], as_index=False)\n","                    .agg(\n","                        inicio=(\"FechaHora\",\"min\"),\n","                        fin=(\"FechaHora\",\"max\"),\n","                        mov=(\"mov\",\"sum\"),\n","                        registros=(\"ID_Trx\",\"count\")\n","                    ))\n","\n","        active[\"duracion_min\"] = (active[\"fin\"] - active[\"inicio\"]).dt.total_seconds() / 60.0\n","\n","        # Resumen global por día (sumar duración promedio entre dispositivos)\n","        daily_active = (active.groupby(\"fecha\", as_index=False)\n","                          .agg(\n","                              dispositivos=(\"Dispositivo\",\"nunique\"),\n","                              duracion_prom_min=(\"duracion_min\",\"mean\"),\n","                              duracion_mediana_min=(\"duracion_min\",\"median\"),\n","                              mov_total=(\"mov\",\"sum\")\n","                          ))\n","        daily_active[\"fecha_dt\"] = pd.to_datetime(daily_active[\"fecha\"])\n","        daily_active = daily_active.sort_values(\"fecha_dt\")\n","\n","        print(f\"Tiempo activo - {mes_txt}\")\n","        print(\"Interpretación: duración entre el primer y último registro del día por dispositivo.\")\n","        display(daily_active.drop(columns=[\"fecha_dt\"]).head(10))\n","\n","        # Gráfica: duración promedio diaria (min) en el mes\n","        plt.figure()\n","        plt.plot(daily_active[\"fecha_dt\"], daily_active[\"duracion_prom_min\"])\n","        plt.title(f\"Tiempo activo promedio por día (min) - {mes_txt}\")\n","        plt.xlabel(\"Fecha\")\n","        plt.ylabel(\"Minutos activos (promedio por dispositivo)\")\n","        plt.grid(True)\n","        plt.show()\n","\n","        # --- 2) Días con movimiento 0 ---\n","        # a) Por dispositivo: días donde mov=0\n","        zeros_dev = active[active[\"mov\"] == 0].copy()\n","\n","        # b) Global: días donde el total del día (sumando dispositivos) es 0\n","        daily_mov = (active.groupby(\"fecha\", as_index=False)[\"mov\"].sum())\n","        daily_mov[\"fecha_dt\"] = pd.to_datetime(daily_mov[\"fecha\"])\n","        daily_mov = daily_mov.sort_values(\"fecha_dt\")\n","\n","        dias_cero_global = daily_mov[daily_mov[\"mov\"] == 0][\"fecha\"].astype(str).tolist()\n","\n","        print(\"\\nDías con movimiento 0 (GLOBAL, sumando todas las unidades):\", len(dias_cero_global))\n","        if len(dias_cero_global) > 0:\n","            print(dias_cero_global[:80], \"...\" if len(dias_cero_global) > 80 else \"\")\n","        else:\n","            print(\"No se detectaron días con movimiento global 0 en este mes.\")\n","\n","        # Conteo de días cero por dispositivo\n","        zeros_count = (zeros_dev.groupby(\"Dispositivo\", as_index=False)\n","                         .agg(dias_mov0=(\"fecha\",\"nunique\"))\n","                         .sort_values(\"dias_mov0\", ascending=False))\n","\n","        print(\"\\nDías con movimiento 0 por dispositivo (top):\")\n","        display(zeros_count.head(20))\n","\n","        # Gráfica: top dispositivos con más días mov=0\n","        topN = zeros_count.head(10)\n","        if not topN.empty:\n","            plt.figure()\n","            plt.bar(topN[\"Dispositivo\"].astype(str), topN[\"dias_mov0\"])\n","            plt.title(f\"Top 10 dispositivos con más días mov=0 - {mes_txt}\")\n","            plt.xlabel(\"Dispositivo\")\n","            plt.ylabel(\"Días con movimiento 0\")\n","            plt.xticks(rotation=45, ha=\"right\")\n","            plt.grid(True, axis=\"y\")\n","            plt.show()\n","\n","        # Mostrar ejemplos de días mov=0 (si existen) para revisar\n","        if not zeros_dev.empty:\n","            print(\"\\nEjemplos (primeros 15) de días con mov=0 por dispositivo:\")\n","            display(zeros_dev.sort_values([\"Dispositivo\",\"fecha\"]).head(15))\n","\n","def on_change(change):\n","    if change[\"type\"] == \"change\" and change[\"name\"] == \"value\":\n","        plot_tiempo_activo_y_ceros(change[\"new\"])\n","\n","dropdown.observe(on_change)\n","\n","display(dropdown, out)\n","plot_tiempo_activo_y_ceros(dropdown.value)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["8f0fa6d5b5824385a5b1b53d9c2f0b07","7a5a03beba56464682b8c24e3a61c979","65a118650c4c40d0a0563633a0795b32","354263cf1dc84d6fa7a20c04b18acbab","8111f0e1c0a2436e931c9538acf8e53e"]},"id":"BotFtw83cZzl","executionInfo":{"status":"ok","timestamp":1772811918155,"user_tz":300,"elapsed":2477,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"a549389a-78af-49a2-87ae-ca084529efe2"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Dropdown(description='Mes:', options=(('Agosto 2025', '2025-08'), ('Septiembre 2025', '2025-09'), ('Octubre 20…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8f0fa6d5b5824385a5b1b53d9c2f0b07"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["Output()"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"354263cf1dc84d6fa7a20c04b18acbab"}},"metadata":{}}]},{"cell_type":"code","source":["# Celda: Zonas calientes por MES (selector) + mapa de calor + clusters (paradas probables)\n","# - Usa GPS válido (Latitud/Longitud != 0)\n","# - Heatmap ponderado por movimiento (subidas+bajadas)\n","# - Clusters (DBSCAN Haversine) como \"paradas probables\"\n","# - Separa zonas de abordaje (subidas) y descenso (bajadas)\n","#\n","# Requiere: df con FechaHora parseado, Latitud, Longitud, SubidasPuerta1/2, BajadasPuerta1/2\n","# En Colab: el mapa se renderiza como salida interactiva.\n","# Si no ves widgets, recarga la página o vuelve a ejecutar la celda de imports/widgets.\n","\n","!pip -q install folium scikit-learn ipywidgets\n","\n","import numpy as np\n","import pandas as pd\n","import folium\n","from folium.plugins import HeatMap\n","from sklearn.cluster import DBSCAN\n","\n","import ipywidgets as widgets\n","from IPython.display import display, clear_output\n","\n","# --- Asegurar columnas base ---\n","df[\"FechaHora\"] = pd.to_datetime(df[\"FechaHora\"], errors=\"coerce\")\n","df_geo = df.dropna(subset=[\"FechaHora\"]).copy()\n","\n","df_geo[\"anio_mes\"] = df_geo[\"FechaHora\"].dt.to_period(\"M\").astype(str)\n","\n","# Convertir a numérico coordenadas\n","df_geo[\"Latitud\"] = pd.to_numeric(df_geo[\"Latitud\"], errors=\"coerce\")\n","df_geo[\"Longitud\"] = pd.to_numeric(df_geo[\"Longitud\"], errors=\"coerce\")\n","\n","# GPS válido\n","df_geo[\"gps_valido\"] = ~((df_geo[\"Latitud\"].fillna(0) == 0) & (df_geo[\"Longitud\"].fillna(0) == 0))\n","\n","# Movimiento\n","df_geo[\"subidas_total\"] = df_geo[\"SubidasPuerta1\"].fillna(0) + df_geo[\"SubidasPuerta2\"].fillna(0)\n","df_geo[\"bajadas_total\"] = df_geo[\"BajadasPuerta1\"].fillna(0) + df_geo[\"BajadasPuerta2\"].fillna(0)\n","df_geo[\"mov\"] = df_geo[\"subidas_total\"] + df_geo[\"bajadas_total\"]\n","\n","# Etiquetas bonitas para mes\n","def etiqueta_mes(ym_str):\n","    dt = pd.to_datetime(ym_str + \"-01\")\n","    meses_es = {1:\"Enero\",2:\"Febrero\",3:\"Marzo\",4:\"Abril\",5:\"Mayo\",6:\"Junio\",\n","                7:\"Julio\",8:\"Agosto\",9:\"Septiembre\",10:\"Octubre\",11:\"Noviembre\",12:\"Diciembre\"}\n","    return f\"{meses_es[dt.month]} {dt.year}\"\n","\n","meses_internos = sorted(df_geo[\"anio_mes\"].dropna().unique().tolist(), key=lambda x: pd.to_datetime(x + \"-01\"))\n","opciones_dropdown = [(etiqueta_mes(m), m) for m in meses_internos]\n","\n","# --- Controles ---\n","dropdown = widgets.Dropdown(\n","    options=opciones_dropdown,\n","    value=meses_internos[0] if len(meses_internos) > 0 else None,\n","    description=\"Mes:\",\n","    disabled=False\n",")\n","\n","# Parámetros DBSCAN (puedes ajustar)\n","eps_m_slider = widgets.IntSlider(value=60, min=20, max=200, step=10, description=\"eps (m):\")\n","min_samples_slider = widgets.IntSlider(value=25, min=5, max=100, step=5, description=\"min_samples:\")\n","\n","# Submuestreo para rendimiento (si hay demasiados puntos)\n","sample_frac_slider = widgets.FloatSlider(value=0.30, min=0.05, max=1.0, step=0.05, description=\"sample:\")\n","\n","run_btn = widgets.Button(description=\"Generar mapas\", button_style=\"primary\")\n","out = widgets.Output()\n","\n","def make_maps(mes, eps_m, min_samples, sample_frac):\n","    with out:\n","        clear_output(wait=True)\n","        mes_txt = etiqueta_mes(mes)\n","\n","        d = df_geo[(df_geo[\"anio_mes\"] == mes) & (df_geo[\"gps_valido\"])].copy()\n","        if d.empty:\n","            print(\"No hay datos GPS válidos para:\", mes_txt)\n","            return\n","\n","        # Usar puntos donde haya movimiento, para zonas calientes reales\n","        d = d[d[\"mov\"] > 0].copy()\n","        if d.empty:\n","            print(\"No hay eventos con movimiento (mov>0) para:\", mes_txt)\n","            return\n","\n","        # Submuestreo si es muy grande\n","        if sample_frac < 1.0:\n","            d = d.sample(frac=sample_frac, random_state=42)\n","\n","        print(f\"{mes_txt} | puntos analizados: {len(d):,} | eps={eps_m}m | min_samples={min_samples} | sample={sample_frac}\")\n","\n","        # Centro del mapa\n","        center_lat = float(d[\"Latitud\"].mean())\n","        center_lon = float(d[\"Longitud\"].mean())\n","\n","        # =========================\n","        # 1) Heatmap de movimiento\n","        # =========================\n","        m_mov = folium.Map(location=[center_lat, center_lon], zoom_start=12)\n","        heat_data_mov = d[[\"Latitud\",\"Longitud\",\"mov\"]].dropna().values.tolist()\n","        HeatMap(heat_data_mov, radius=10, blur=15, max_zoom=13).add_to(m_mov)\n","\n","        # =========================\n","        # 2) Heatmap subidas (abordaje)\n","        # =========================\n","        m_sub = folium.Map(location=[center_lat, center_lon], zoom_start=12)\n","        heat_data_sub = d[d[\"subidas_total\"] > 0][[\"Latitud\",\"Longitud\",\"subidas_total\"]].dropna().values.tolist()\n","        if len(heat_data_sub) > 0:\n","            HeatMap(heat_data_sub, radius=10, blur=15, max_zoom=13).add_to(m_sub)\n","\n","        # =========================\n","        # 3) Heatmap bajadas (descenso)\n","        # =========================\n","        m_baj = folium.Map(location=[center_lat, center_lon], zoom_start=12)\n","        heat_data_baj = d[d[\"bajadas_total\"] > 0][[\"Latitud\",\"Longitud\",\"bajadas_total\"]].dropna().values.tolist()\n","        if len(heat_data_baj) > 0:\n","            HeatMap(heat_data_baj, radius=10, blur=15, max_zoom=13).add_to(m_baj)\n","\n","        # =========================\n","        # 4) Clusters (paradas probables) con DBSCAN Haversine\n","        # =========================\n","        coords = d[[\"Latitud\",\"Longitud\"]].dropna().to_numpy()\n","        coords_rad = np.radians(coords)\n","\n","        eps = eps_m / 6371000  # metros a radianes\n","        db = DBSCAN(eps=eps, min_samples=min_samples, metric=\"haversine\")\n","        labels = db.fit_predict(coords_rad)\n","\n","        d = d.loc[d[[\"Latitud\",\"Longitud\"]].dropna().index].copy()\n","        d[\"cluster\"] = labels\n","\n","        clusters = (d[d[\"cluster\"] != -1]\n","                    .groupby(\"cluster\", as_index=False)\n","                    .agg(\n","                        lat_c=(\"Latitud\",\"mean\"),\n","                        lon_c=(\"Longitud\",\"mean\"),\n","                        eventos=(\"cluster\",\"size\"),\n","                        subidas=(\"subidas_total\",\"sum\"),\n","                        bajadas=(\"bajadas_total\",\"sum\"),\n","                        mov=(\"mov\",\"sum\")\n","                    )\n","                    .sort_values(\"mov\", ascending=False))\n","\n","        # Mapa de clusters (top 30)\n","        m_clusters = folium.Map(location=[center_lat, center_lon], zoom_start=12)\n","\n","        topN = clusters.head(30).copy()\n","        for _, r in topN.iterrows():\n","            popup = (\n","                f\"Cluster {int(r['cluster'])}<br>\"\n","                f\"mov={int(r['mov'])}<br>\"\n","                f\"subidas={int(r['subidas'])}<br>\"\n","                f\"bajadas={int(r['bajadas'])}<br>\"\n","                f\"eventos={int(r['eventos'])}\"\n","            )\n","            folium.CircleMarker(\n","                location=[float(r[\"lat_c\"]), float(r[\"lon_c\"])],\n","                radius=6,\n","                popup=popup,\n","                fill=True\n","            ).add_to(m_clusters)\n","\n","        # -------- Salidas --------\n","        if clusters.empty:\n","            print(\"No se detectaron clusters (paradas probables). Prueba aumentar sample, bajar min_samples o subir eps.\")\n","        else:\n","            print(\"\\nTop 10 clusters (paradas probables) por movimiento:\")\n","            display(clusters.head(10))\n","\n","        print(\"\\nMapa 1/4: Heatmap MOVIMIENTO (subidas+bajadas)\")\n","        display(m_mov)\n","\n","        print(\"\\nMapa 2/4: Heatmap ABORDAJE (subidas)\")\n","        display(m_sub)\n","\n","        print(\"\\nMapa 3/4: Heatmap DESCENSO (bajadas)\")\n","        display(m_baj)\n","\n","        print(\"\\nMapa 4/4: Clusters / Paradas probables (top 30)\")\n","        display(m_clusters)\n","\n","def on_run(_):\n","    make_maps(dropdown.value, eps_m_slider.value, min_samples_slider.value, sample_frac_slider.value)\n","\n","run_btn.on_click(on_run)\n","\n","display(widgets.HBox([dropdown, eps_m_slider, min_samples_slider, sample_frac_slider, run_btn]), out)\n","\n","# Ejecutar una vez por defecto\n","make_maps(dropdown.value, eps_m_slider.value, min_samples_slider.value, sample_frac_slider.value)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["8193a6c3dc0649f28630d186b07ed525","1e7a2dd006084666af7900ad939b3428","d1e410427e1343fd820e8e93461d3999","a1154b34a97d42e4abe358780e5846c9","544f6de81c8046c1b966f01c44bd2124","78346f5ede164f3e80773ab9c2e2617f","ff7c2dee4b444415a7881746f78aa6c1","fb59f955ee164838a59d2d34bc76a0f9","b09f157ac9834be194d25f1c0ec0f499","3ab0c7e374294bbba1a138dc19b2255c","3cef937aa8694bc09098d5e53fe33aa9","4d4319efd4ae414e8f1acddc74be636e","ef09cfe1c77b41e8a0b31e91a6e9cbd6","4bd6137d5f8d4bee9b2756f9dc992f43","022a3cdc1462456d8c0b3797eca5ad26","dbc53c5e11c2480489d133bc07d7c303","b188cadcae5b4d6ea84a8aaf1555396b","3c90d1cd173148618584be2e5322167d","e0e78666305245209d544950505c08e4"]},"id":"QQfyaZIRePxh","executionInfo":{"status":"ok","timestamp":1772811927562,"user_tz":300,"elapsed":9404,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"144fd5ab-dbf8-4122-8a9f-37036f6de94c"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["HBox(children=(Dropdown(description='Mes:', options=(('Agosto 2025', '2025-08'), ('Septiembre 2025', '2025-09'…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8193a6c3dc0649f28630d186b07ed525"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["Output()"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3c90d1cd173148618584be2e5322167d"}},"metadata":{}}]},{"cell_type":"code","source":["# PUNTOS COLOREADOS POR DENSIDAD + HEATMAP (por mes)\n","# Requiere: df_geo y controles (dropdown) como en tu celda anterior.\n","# Si no tienes df_geo, usa df y crea df_geo igual que antes.\n","\n","import numpy as np\n","import pandas as pd\n","import folium\n","from folium.plugins import HeatMap\n","import ipywidgets as widgets\n","from IPython.display import display, clear_output\n","\n","# --- controles extra ---\n","grid_decimals_slider = widgets.IntSlider(value=4, min=2, max=5, step=1, description=\"grid dec:\")\n","# 2 ≈ 1.1km, 3 ≈ 111m, 4 ≈ 11m, 5 ≈ 1.1m aprox\n","\n","modo_dropdown = widgets.Dropdown(\n","    options=[(\"Movimiento (subidas+bajadas)\", \"mov\"), (\"Abordaje (subidas)\", \"sub\"), (\"Descenso (bajadas)\", \"baj\")],\n","    value=\"mov\",\n","    description=\"Modo:\"\n",")\n","\n","run_btn2 = widgets.Button(description=\"Mapa densidad + calor\", button_style=\"danger\")\n","out3 = widgets.Output()\n","\n","def color_por_cuantil(v, q1, q2, q3):\n","    # 4 niveles: azul (bajo) -> amarillo -> naranja -> rojo (alto)\n","    if v <= q1: return \"blue\"\n","    if v <= q2: return \"yellow\"\n","    if v <= q3: return \"orange\"\n","    return \"red\"\n","\n","def make_density_map(mes, grid_decimals=4, modo=\"mov\"):\n","    with out3:\n","        clear_output(wait=True)\n","        mes_txt = etiqueta_mes(mes)\n","\n","        d = df_geo[(df_geo[\"anio_mes\"] == mes) & (df_geo[\"gps_valido\"])].copy()\n","        if d.empty:\n","            print(\"No hay datos GPS válidos para:\", mes_txt)\n","            return\n","\n","        # Elegir variable para densidad\n","        if modo == \"mov\":\n","            d = d[d[\"mov\"] > 0].copy()\n","            weight_col = \"mov\"\n","            titulo = \"Densidad por MOVIMIENTO (subidas+bajadas)\"\n","        elif modo == \"sub\":\n","            d = d[d[\"subidas_total\"] > 0].copy()\n","            weight_col = \"subidas_total\"\n","            titulo = \"Densidad por ABORDAJE (subidas)\"\n","        else:\n","            d = d[d[\"bajadas_total\"] > 0].copy()\n","            weight_col = \"bajadas_total\"\n","            titulo = \"Densidad por DESCENSO (bajadas)\"\n","\n","        if d.empty:\n","            print(\"No hay eventos con valor > 0 para:\", mes_txt, \"| modo:\", modo)\n","            return\n","\n","        # --- Grid / celdas para agrupar coordenadas cercanas ---\n","        d[\"lat_bin\"] = d[\"Latitud\"].round(grid_decimals)\n","        d[\"lon_bin\"] = d[\"Longitud\"].round(grid_decimals)\n","\n","        agg = (d.groupby([\"lat_bin\",\"lon_bin\"], as_index=False)\n","                 .agg(\n","                     puntos=(\"lat_bin\",\"size\"),                 # frecuencia (densidad)\n","                     demanda=(weight_col,\"sum\"),               # suma de demanda\n","                     lat=(\"Latitud\",\"mean\"),\n","                     lon=(\"Longitud\",\"mean\")\n","                 ))\n","\n","        # Cuantiles por densidad (puntos repetidos)\n","        q1, q2, q3 = agg[\"puntos\"].quantile([0.25, 0.50, 0.75]).tolist()\n","\n","        center_lat = float(agg[\"lat\"].mean())\n","        center_lon = float(agg[\"lon\"].mean())\n","\n","        # --- Mapa base ---\n","        m = folium.Map(location=[center_lat, center_lon], zoom_start=12)\n","\n","        # --- Heatmap (ponderado por demanda) ---\n","        heat_data = agg[[\"lat\",\"lon\",\"demanda\"]].values.tolist()\n","        HeatMap(heat_data, radius=12, blur=18, max_zoom=13).add_to(m)\n","\n","        # --- Puntos coloreados por densidad ---\n","        # Tip: para no saturar el mapa, muestra los top N por densidad\n","        # Puedes subir o bajar N\n","        N = 1500\n","        agg_show = agg.sort_values(\"puntos\", ascending=False).head(N).copy()\n","\n","        for _, r in agg_show.iterrows():\n","            col = color_por_cuantil(r[\"puntos\"], q1, q2, q3)\n","\n","            # radio según densidad (suave)\n","            radius = 3\n","            if r[\"puntos\"] > q3: radius = 7\n","            elif r[\"puntos\"] > q2: radius = 6\n","            elif r[\"puntos\"] > q1: radius = 5\n","\n","            popup = (\n","                f\"{mes_txt}<br>\"\n","                f\"densidad (repeticiones/celda): {int(r['puntos'])}<br>\"\n","                f\"demanda (suma): {int(r['demanda'])}<br>\"\n","                f\"grid_decimals: {grid_decimals}\"\n","            )\n","\n","            folium.CircleMarker(\n","                location=[float(r[\"lat\"]), float(r[\"lon\"])],\n","                radius=radius,\n","                color=col,\n","                fill=True,\n","                fill_color=col,\n","                fill_opacity=0.75,\n","                popup=popup\n","            ).add_to(m)\n","\n","        print(f\"{titulo} - {mes_txt}\")\n","        print(f\"Grid decimales: {grid_decimals} | celdas únicas: {len(agg):,} | puntos mostrados: {len(agg_show):,}\")\n","        print(f\"Cuantiles densidad (puntos/celda): Q25={q1:.1f}, Q50={q2:.1f}, Q75={q3:.1f}\")\n","        print(\"Colores: azul=bajo, amarillo=medio-bajo, naranja=medio-alto, rojo=alto\")\n","        display(agg.sort_values(\"puntos\", ascending=False).head(10))\n","        display(m)\n","\n","def on_run2(_):\n","    make_density_map(dropdown.value, grid_decimals_slider.value, modo_dropdown.value)\n","\n","run_btn2.on_click(on_run2)\n","\n","display(widgets.HBox([dropdown, modo_dropdown, grid_decimals_slider, run_btn2]), out3)\n","\n","# Ejecutar una vez por defecto\n","make_density_map(dropdown.value, grid_decimals_slider.value, modo_dropdown.value)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":811,"referenced_widgets":["387dd43723dc4686a44bf281ccf77414","1e7a2dd006084666af7900ad939b3428","19fca9f8c0a845a5ba307b7bc0a55ebd","8cb75a1eb38145e1a95c54a7e7da27e4","218f36ba102548e289ec6172acac26e1","e28b7cbb5bcf4e428c470b4afe922d4a","fb59f955ee164838a59d2d34bc76a0f9","b09f157ac9834be194d25f1c0ec0f499","c692eae4259b465c96e05560e02e39a3","1f3337253e664c1a8c3127ba9bb28fe7","a696d53a109f443d90197b38c733b680","43f7c8c1f94d4e51b179f2ce8ddc7f85","245412a4f0c54ae6bd53b691860e5da7","5c10a0ee37364a6d84d467e3e8083cdd","f29422e4f2c147b195aa60af37dcb3e1","d59a59ac67ba40768b5673d74cd08578"]},"id":"FELX0xyIgkqf","executionInfo":{"status":"ok","timestamp":1772811932770,"user_tz":300,"elapsed":5202,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"c8b6aeec-fee8-4365-9b82-dfc5541ad8f1"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["HBox(children=(Dropdown(description='Mes:', options=(('Agosto 2025', '2025-08'), ('Septiembre 2025', '2025-09'…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"387dd43723dc4686a44bf281ccf77414"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["Output()"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f29422e4f2c147b195aa60af37dcb3e1"}},"metadata":{}}]},{"cell_type":"code","source":["# Celda: Comparativa en UNA sola gráfica (meses) + datos relevantes (tabla resumen)\n","# - Compara meses por: mov_total (barras) y mov_prom_dia (línea) en el mismo gráfico\n","# - Muestra también balance neto y % de GPS inválido en una tabla (relevante para calidad y operación)\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Asegurar columnas base\n","df[\"FechaHora\"] = pd.to_datetime(df[\"FechaHora\"], errors=\"coerce\")\n","d = df.dropna(subset=[\"FechaHora\"]).copy()\n","\n","d[\"anio_mes\"] = d[\"FechaHora\"].dt.to_period(\"M\").astype(str)\n","d[\"fecha\"] = d[\"FechaHora\"].dt.date\n","\n","# Movimiento\n","if \"subidas_total\" not in d.columns:\n","    d[\"subidas_total\"] = d[\"SubidasPuerta1\"].fillna(0) + d[\"SubidasPuerta2\"].fillna(0)\n","if \"bajadas_total\" not in d.columns:\n","    d[\"bajadas_total\"] = d[\"BajadasPuerta1\"].fillna(0) + d[\"BajadasPuerta2\"].fillna(0)\n","d[\"mov\"] = d[\"subidas_total\"] + d[\"bajadas_total\"]\n","d[\"balance\"] = d[\"subidas_total\"] - d[\"bajadas_total\"]\n","\n","# GPS válido (si no existe)\n","if \"gps_valido\" not in d.columns:\n","    d[\"Latitud\"] = pd.to_numeric(d[\"Latitud\"], errors=\"coerce\")\n","    d[\"Longitud\"] = pd.to_numeric(d[\"Longitud\"], errors=\"coerce\")\n","    d[\"gps_valido\"] = ~((d[\"Latitud\"].fillna(0) == 0) & (d[\"Longitud\"].fillna(0) == 0))\n","\n","# Resumen mensual\n","monthly_cmp = (d.groupby(\"anio_mes\", as_index=False)\n","               .agg(\n","                   subidas=(\"subidas_total\",\"sum\"),\n","                   bajadas=(\"bajadas_total\",\"sum\"),\n","                   mov=(\"mov\",\"sum\"),\n","                   balance=(\"balance\",\"sum\"),\n","                   dias=(\"fecha\",\"nunique\"),\n","                   registros=(\"ID_Trx\",\"count\"),\n","                   gps_invalidos=(\"gps_valido\", lambda s: (~s).sum())\n","               ))\n","\n","monthly_cmp[\"mov_prom_dia\"] = monthly_cmp[\"mov\"] / monthly_cmp[\"dias\"]\n","monthly_cmp[\"pct_gps_invalido\"] = 100 * monthly_cmp[\"gps_invalidos\"] / monthly_cmp[\"registros\"]\n","\n","# Orden cronológico\n","monthly_cmp[\"anio_mes_dt\"] = pd.to_datetime(monthly_cmp[\"anio_mes\"] + \"-01\")\n","monthly_cmp = monthly_cmp.sort_values(\"anio_mes_dt\").drop(columns=[\"anio_mes_dt\"])\n","\n","# Etiquetas bonitas\n","def etiqueta_mes(ym_str):\n","    dt = pd.to_datetime(ym_str + \"-01\")\n","    meses_es = {1:\"Ene\",2:\"Feb\",3:\"Mar\",4:\"Abr\",5:\"May\",6:\"Jun\",7:\"Jul\",8:\"Ago\",9:\"Sep\",10:\"Oct\",11:\"Nov\",12:\"Dic\"}\n","    return f\"{meses_es[dt.month]}-{dt.year}\"\n","\n","monthly_cmp[\"mes_lbl\"] = monthly_cmp[\"anio_mes\"].apply(etiqueta_mes)\n","\n","# ---------- Gráfica única (barras + línea) ----------\n","x = np.arange(len(monthly_cmp))\n","\n","fig, ax1 = plt.subplots()\n","\n","# Barras: movimiento total (demanda mensual)\n","ax1.bar(x, monthly_cmp[\"mov\"])\n","ax1.set_xlabel(\"Mes\")\n","ax1.set_ylabel(\"Movimiento total (mensual)\")\n","ax1.set_title(\"Comparativa mensual: Demanda (mov total) + Promedio diario\")\n","\n","ax1.set_xticks(x)\n","ax1.set_xticklabels(monthly_cmp[\"mes_lbl\"], rotation=45, ha=\"right\")\n","ax1.grid(True, axis=\"y\")\n","\n","# Línea: promedio diario (para comparar meses incompletos)\n","ax2 = ax1.twinx()\n","ax2.plot(x, monthly_cmp[\"mov_prom_dia\"], marker=\"o\")\n","ax2.set_ylabel(\"Mov promedio por día\")\n","\n","plt.show()\n","\n","# ---------- Datos relevantes (tabla) ----------\n","# Orden por mov (para ver meses top) sin perder tabla cronológica\n","top_months = monthly_cmp.sort_values(\"mov\", ascending=False)[\n","    [\"anio_mes\",\"subidas\",\"bajadas\",\"mov\",\"mov_prom_dia\",\"balance\",\"dias\",\"pct_gps_invalido\"]\n","].head(10)\n","\n","print(\"Top meses por demanda (mov total):\")\n","display(top_months)\n","\n","print(\"\\nResumen mensual (cronológico):\")\n","display(monthly_cmp[[\"anio_mes\",\"subidas\",\"bajadas\",\"mov\",\"mov_prom_dia\",\"balance\",\"dias\",\"pct_gps_invalido\"]])\n","\n","# (Opcional) Exportar\n","monthly_cmp.to_csv(\"/content/comparativa_mensual_kpis.csv\", index=False, encoding=\"utf-8-sig\")\n","print(\"\\nExportado: /content/comparativa_mensual_kpis.csv\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"txdg7zrzhbmF","executionInfo":{"status":"ok","timestamp":1772811936731,"user_tz":300,"elapsed":3958,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"4c9d0bcc-dadf-49e0-c04d-14896ba0871a"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Top meses por demanda (mov total):\n"]},{"output_type":"display_data","data":{"text/plain":["  anio_mes  subidas  bajadas     mov  mov_prom_dia  balance  dias  \\\n","2  2025-10    51924    55265  107189   3457.709677    -3341    31   \n","3  2025-11    43332    44100   87432   2914.400000     -768    30   \n","4  2025-12    40136    42175   82311   2655.193548    -2039    31   \n","5  2026-01    37925    38690   76615   2471.451613     -765    31   \n","1  2025-09    32228    33530   65758   2191.933333    -1302    30   \n","0  2025-08    22251    22678   44929   1797.160000     -427    25   \n","6  2026-02    13631    13485   27116   2711.600000      146    10   \n","\n","   pct_gps_invalido  \n","2          2.783405  \n","3         11.764148  \n","4          3.496091  \n","5          0.126343  \n","1          3.610801  \n","0          8.979912  \n","6          0.021211  "],"text/html":["\n","  <div id=\"df-c93cc388-be51-4058-9bb3-93e96b2d8b31\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tb