{"cell_type":"code","metadata":{"id":"g0hEtU0N-zwJ","colab":{"base_uri":"https://localhost:8080/","height":406},"executionInfo":{"status":"ok","timestamp":1750286491540,"user_tz":300,"elapsed":1178,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"3b33c0e8-8733-4b37-d535-beefb2b6eac3"},"source":["e_labs={(\"B\",\"A\"):1,(\"A\",\"E\"):2,(\"E\",\"G\"):3,(\"G\",\"D\"):4,(\"D\",\"E\"):5,(\"E\",\"I\"):6,(\"I\",\"H\"):7,(\"H\",\"J\"):8,(\"J\",\"L\"):9,(\"L\",\"H\"):10,(\"H\",\"G\"):11,(\"G\",\"J\"):12,(\"J\",\"K\"):13,(\"K\",\"L\"):14,(\"L\",\"I\"):15,(\"I\",\"F\"):16,(\"F\",\"C\"):17,(\"C\",\"B\"):18,(\"B\",\"E\"):19}\n","\n","nx.draw_networkx_edge_labels(G, pos, e_labs, font_size=8)\n","nx.draw(E, pos, node_color = 'r', edge_color=\"r\")\n","nx.draw(G, pos, with_labels=True)"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# <font color=\"red\">▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄</font>\n"],"metadata":{"id":"q7b6CMDP2_2m"}},{"cell_type":"markdown","metadata":{"id":"WWVoyzHjrZKh"},"source":["# <font color=\"red\">Actividad</font>\n","\n","#Determina si en la siguientes gráficas existe un camino o circuito de Euler y, en su caso, determina y muestra la secuencia de aristas."]},{"cell_type":"markdown","metadata":{"id":"ol2FsIUaEC-r"},"source":["## Ejemplo 2\n","\n"]},{"cell_type":"code","metadata":{"id":"Z-xxAyRM_q_d","colab":{"base_uri":"https://localhost:8080/","height":516},"executionInfo":{"status":"ok","timestamp":1750286491995,"user_tz":300,"elapsed":452,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"eac06c68-57e5-471f-ac2a-ec447e83bc0e"},"source":["G = nx.Graph()\n","\n","G.add_nodes_from([\"A\",\"B\",\"C\",\"D\",\"E\",\"F\",\"G\",\"H\",\"I\"])\n","G.add_edges_from([(\"A\",\"B\"),(\"A\",\"D\"),(\"B\",\"C\"),(\"B\",\"D\"),(\"B\",\"F\"),(\"C\",\"E\"),(\"D\",\"G\"),(\"D\",\"H\"),(\"E\",\"I\"),(\"F\",\"H\"),(\"G\",\"H\"),(\"H\",\"I\")])\n","\n","pos = {'A': [ 0, 2],'B': [1,2],'C': [2,2],'D': [0,1],'E': [1,1],'F': [2,1],'G': [0,0],'H': [1,0],'I': [2,0]}\n","\n","nx.draw(G, pos, with_labels=True)\n"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Para analizar si este grafo tiene un **camino de Euler**, revisamos el **grado** (número de conexiones) de cada nodo:\n","\n","1. **Condición para el camino de Euler**: Un grafo tiene un camino de Euler si exactamente dos nodos tienen un grado impar. Estos nodos serán el inicio y el fin del camino.\n","2. **Grados de los nodos**:\n","   - \\(A\\), \\(C\\), \\(E\\), \\(F\\), y \\(G\\) tienen un grado impar.\n","3. **Conclusión**: Como hay cinco nodos con grado impar, el grafo **no tiene un camino de Euler**. Para tenerlo, debería tener solo dos nodos con grado impar.\n","\n","Este grafo, entonces, no cumple con la condición necesaria para un camino de Euler."],"metadata":{"id":"cQIv_9nq0hg7"}},{"cell_type":"code","source":["\n","\n","def existe_camino_euler(grafo):\n","    nodos_impares = [nodo for nodo, grado in grafo.degree() if grado % 2 != 0]\n","\n","    if len(nodos_impares) == 0:\n","        return \"Existe un circuito de Euler.\", encontrar_camino_euler(grafo)\n","    elif len(nodos_impares) == 2:\n","        return \"Existe un camino de Euler.\", encontrar_camino_euler(grafo, nodos_impares[0])\n","    else:\n","        return \"No existe un camino de Euler.\", None\n","\n","def encontrar_camino_euler(grafo, inicio=None):\n","    if inicio is None:\n","        inicio = list(grafo.nodes())[0]\n","    copia_grafo = grafo.copy()\n","    camino = []\n","\n","    def recorrer(nodo):\n","        for vecino in list(copia_grafo.neighbors(nodo)):\n","            if copia_grafo.has_edge(nodo, vecino):\n","                copia_grafo.remove_edge(nodo, vecino)\n","                recorrer(vecino)\n","        camino.append(nodo)\n","\n","    recorrer(inicio)\n","    return camino[::-1]\n","\n","def mostrar_camino_euler(grafo, camino, pos):\n","    plt.figure(figsize=(10, 8))\n","    colores_nodos = {nodo: \"lightgreen\" for nodo in grafo.nodes()}\n","    colores_aristas = {arista: \"gray\" for arista in grafo.edges()}\n","\n","    for i in range(len(camino) - 1):\n","        u, v = camino[i], camino[i + 1]\n","\n","        # Cambiar color de los nodos y aristas en el camino\n","        colores_nodos[u] = \"green\"  # Cambiado a verde\n","        colores_nodos[v] = \"green\"  # Cambiado a verde\n","        colores_aristas[(u, v) if (u, v) in colores_aristas else (v, u)] = \"red\"\n","\n","        # Dibujar el grafo con los colores actualizados en cada paso\n","        plt.clf()\n","        etiquetas_camino = {nodo: f\"Camino {i+1}\" for i, nodo in enumerate(camino[:i+1])}\n","        nx.draw(grafo, pos, with_labels=True, node_size=700, font_size=10, font_weight=\"bold\",\n","                node_color=[colores_nodos[nodo] for nodo in grafo.nodes()],\n","                edge_color=[colores_aristas[arista] for arista in grafo.edges()],\n","                labels=etiquetas_camino)\n","\n","        # Añadir una flecha a la arista actual\n","        nx.draw_networkx_edges(grafo, pos, edgelist=[(u, v)], width=2, edge_color=\"red\",\n","                               connectionstyle=\"arc3,rad=0.1\", arrows=True, arrowstyle=\"-|>\", arrowsize=20)\n","\n","        plt.pause(0.8)\n","\n","    plt.show()\n","\n","# Crear el grafo y probar el programa\n","G = nx.Graph()\n","G.add_nodes_from([\"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\", \"I\"])\n","G.add_edges_from([(\"A\", \"B\"), (\"A\", \"D\"), (\"B\", \"C\"), (\"B\", \"D\"), (\"B\", \"F\"),\n","                  (\"C\", \"E\"), (\"D\", \"G\"), (\"D\", \"H\"), (\"E\", \"I\"), (\"F\", \"H\"),\n","                  (\"G\", \"H\"), (\"H\", \"I\")])\n","\n","# Posiciones de los nodos\n","pos = {'A': [0, 2], 'B': [1, 2], 'C': [2, 2], 'D': [0, 1], 'E': [1, 1],\n","       'F': [2, 1], 'G': [0, 0], 'H': [1, 0], 'I': [2, 0]}\n","\n","# Verificar la existencia de un camino de Euler y, si existe, graficarlo\n","resultado, camino = existe_camino_euler(G)\n","print(resultado)\n","if camino:\n","    print(\"Secuencia del camino de Euler:\", \" -> \".join(camino))\n","    mostrar_camino_euler(G, camino, pos)\n","else:\n","    print(\"No se pudo encontrar un camino de Euler.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"KZd0waTNvleg","executionInfo":{"status":"ok","timestamp":1750286505376,"user_tz":300,"elapsed":13379,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"e252467a-82af-4a43-ec09-c1b4c96b904b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Existe un circuito de Euler.\n","Secuencia del camino de Euler: A -> B -> C -> E -> I -> H -> D -> B -> F -> H -> G -> D -> A\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x48