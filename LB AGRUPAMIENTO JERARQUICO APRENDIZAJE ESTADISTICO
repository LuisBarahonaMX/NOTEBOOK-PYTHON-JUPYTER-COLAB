ta dimensionalidad y\n","desentrañar relaciones y estructuras subyacentes."],"metadata":{"id":"TEgrBZJZr4Fh"}},{"cell_type":"markdown","source":["![](https://www.diegocalvo.es/wp-content/uploads/2018/03/cluster-jer%C3%A1rquico-vs-cluster-no-jer%C3%A1rquico.png)"],"metadata":{"id":"KPS11cYHsE49"}},{"cell_type":"markdown","source":["## **LIBRERIAS**"],"metadata":{"id":"ez4RCng-r7ih"}},{"cell_type":"code","source":["# Importamos las bibliotecas necesarias\n","import numpy as np  # Importamos la biblioteca NumPy para manipulación de matrices y datos numéricos\n","import matplotlib.pyplot as plt  # Importamos Matplotlib para la visualización de datos\n","from scipy.cluster.hierarchy import dendrogram, linkage, cut_tree  # Importamos funciones relacionadas con clustering jerárquico\n","from sklearn.cluster import AgglomerativeClustering  # Importamos la clase AgglomerativeClustering de scikit-learn\n","import pandas as pd  # Importamos Pandas para el manejo de datos en forma de DataFrames\n","import seaborn as sns  # Importamos Seaborn para gráficos estadísticos más atractivos\n","from sklearn.preprocessing import StandardScaler  # Importamos StandardScaler para estandarizar los datos\n","from scipy import cluster  # Esto parece ser una importación incorrecta, ya que no existe \"cluster\" en SciPy"],"metadata":{"id":"Tkr840FRoiSA"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## **DATOS DE IRIS**"],"metadata":{"id":"IBoR_7V6nlgf"}},{"cell_type":"code","source":["# Importamos el conjunto de datos \"Iris\" desde scikit-learn\n","from sklearn.datasets import load_iris\n","# Cargamos el conjunto de datos \"Iris\" en la variable \"iris\"\n","iris = load_iris()\n","# Extraemos los datos de características del conjunto de datos Iris y los almacenamos en \"data_iris\"\n","data_iris = iris.data"],"metadata":{"id":"sKR5qUCJoj0X"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Q16BM5hLgYB7","colab":{"base_