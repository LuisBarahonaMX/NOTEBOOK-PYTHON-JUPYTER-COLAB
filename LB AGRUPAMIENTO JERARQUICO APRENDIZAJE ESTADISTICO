# Definimos una función llamada \"show_boxplot\" que muestra un gráfico de caja para visualizar la distribución de los datos en un DataFrame.\n","def show_boxplot(df):\n","    # Establecemos el tamaño de la figura para el gráfico de caja\n","    plt.rcParams['figure.figsize'] = [14, 6]\n","    # Creamos un gráfico de caja (box plot) utilizando Seaborn, pasando el DataFrame \"df\" y orientación vertical (\"v\").\n","    sns.boxplot(data=df, orient=\"v\")\n","    # Establecemos el título del gráfico.\n","    plt.title(\"Distribución de valores atípicos\", fontsize=16)\n","    # Etiquetamos el eje Y.\n","    plt.ylabel(\"Rango\", fontweight='bold')\n","    # Etiquetamos el eje X.\n","    plt.xlabel(\"Atributos\", fontweight='bold')\n","# Llamamos a la función \"show_boxplot\" pasando el DataFrame \"loan_data_iris\" como argumento.\n","show_boxplot(loan_data_iris)"],"metadata":{"id":"3GEbnYhcitHa","colab":{"base_uri":"https://localhost:8080/","height":568},"outputId":"5d2730f1-9645-4c04-eba2-41d623056dfd"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Definimos una función llamada \"remove_outliers\" que elimina los valores atípicos de un DataFrame.\n","def remove_outliers(data):\n","    # Creamos una copia del DataFrame \"data\" para no modificar el original.\n","    df = data.copy()\n","    # Recorremos todas las columnas del DataFrame.\n","    for col in list(df.columns):\n","        # Calculamos el primer cuartil (Q1) y el tercer cuartil (Q3) para la columna actual.\n","        Q1 = df[str(col)].quantile(0.05)\n","        Q3 = df[str(col)].quantile(0.95)\n","        # Calculamos el rango intercuartílico (IQR) como la diferencia entre Q3 y Q1.\n","        IQR = Q3 - Q1\n","        # Calculamos los límites inferior y superior para identificar valores atípicos.\n","        lower_bound = Q1 - 1.5 * IQR\n","        upper_bound = Q3 + 1.5 * IQR\n","        # Filtramos el DataFrame para mantener solo los valores que están dentro de los límites.\n","        df = df[(df[str(col)] >= lower_bound) & (df[str(col)] <= upper_bound)]\n","    # Devolvemos el DataFrame sin valores atípicos.\n","    return df"],"metadata":{"id":"mkPZVPFCitFa"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Utilizamos la función \"remove_outliers\" para eliminar valores atípicos del DataFrame \"loan_data_iris\".\n","without_outliers_iris = remove_outliers(loan_data_iris)\n","# Luego, llamamos a la función \"show_boxplot\" para mostrar un gráfico de caja de los datos sin valores atípicos.\n","show_boxplot(without_outliers_iris)"],"metadata":{"id":"xSWRQ5-ritCc","colab":{"base_uri":"https://localhost:8080/","height":568},"outputId":"2e645586-3743-495f-d873-f2d87182b2e9"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Obtenemos la forma (número de filas y columnas) del DataFrame \"without_outliers_iris\"\n","without_outliers_iris.shape"],"metadata":{"id":"2S5zhc6_jiRW","colab":{"base_uri":"https://localhost:8080/"},"outputId":"7693c64e-667b-459c-8c0a-f732d4298018"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["(150, 4)"]},"metadata":{},"execution_count":115}]},{"cell_type":"code","source":["# Creamos una instancia de StandardScaler para escalar los datos.\n","data_scaler_iris = StandardScaler()\n","# Utilizamos el método fit_transform para escalar los datos en \"without_outliers_iris\".\n","scaled_data_iris = data_scaler_iris.fit_transform(without_outliers_iris)\n","# Obtenemos la forma (número de filas y columnas) de los datos escalados.\n","scaled_data_iris.shape"],"metadata":{"id":"nr-fYOxOjiOu","colab":{"base_uri":"https://localhost:8080/"},"outputId":"ec960d22-9503-4e59-abc4-61bc025f21e1"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["(150, 4)"]},"metadata":{},"execution_count":116}]},{"cell_type":"code","source":["# Realizamos clustering jerárquico utilizando el método \"complete\" y la distancia euclidiana en los datos escalados \"scaled_data_iris\".\n","complete_clustering_iris = linkage(scaled_data_iris, method=\"complete\", metric=\"euclidean\")\n","# Creamos un dendrograma para visualizar la estructura de agrupación en el clustering jerárquico.\n","dendrogram(complete_clustering_iris)\n","# Agregamos un título al dendrograma.\n","plt.title(\"Dendrograma de agrupamiento completo\")\n","# Mostramos el dendrograma en la pantalla.\n","plt.show()"],"metadata":{"id":"Vs4anEnRjowx","colab":{"base_uri":"https://localhost:8080/","height":544},"outputId":"8c19e215-fd9e-49d2-ecee-4380ca284e84"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Realizamos clustering jerárquico con el método \"average\" en los datos escalados utilizando la métrica \"euclidean\".\n","average_clustering_iris = linkage(scaled_data_iris, method=\"average\", metric=\"euclidean\")\n","# Creamos un dendrograma para visualizar la jerarquía de agrupación resultante.\n","dendrogram(average_clustering_iris)\n","# Establecemos un título para el dendrograma.\n","plt.title(\"Dendrograma de agrupamiento promedio\")\n","# Mostramos el dendrograma en la pantalla.\n","plt.show()"],"metadata":{"id":"URZ1WS3Xj54T","colab":{"base_uri":"https://localhost:8080/","height":544},"outputId":"e1485231-4e77-4b16-9e88-0470feff101e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Realizamos clustering jerárquico con el método \"median\" en los datos escalados utilizando la métrica \"euclidean\".\n","m