","\n","    buffer = io.BytesIO()\n","    c = canvas.Canvas(buffer, pagesize=letter)\n","    width, height = letter\n","\n","    # Añadir un marco decorativo\n","    c.setStrokeColor(colors.black)\n","    c.setLineWidth(2)\n","    c.rect(30, 30, width - 60, height - 60)  # Dibuja un marco alrededor del contenido\n","\n","    # Añadir el título en verde con una fuente más agradable\n","    c.setFont(\"Helvetica-Bold\", 24)\n","    c.setFillColor(colors.green)\n","    c.drawString(40, height - 80, \"Servicio de Taxi Particular\")\n","\n","    # Añadir el contenido del reporte\n","    c.setFont(\"Helvetica\", 12)\n","    y = height - 120\n","\n","    detalles = [\n","        f\"Fecha de inicio del servicio: {fecha_inicio}\",\n","        f\"Hora de inicio: {hora_inicio}\",\n","        f\"Hora de finalización: {hora_fin}\",\n","        f\"Duración total del servicio: {duracion_servicio}\",\n","        f\"Costo del tiempo extra: ${costo_extra:.2f}\"\n","    ]\n","\n","    for detalle in detalles:\n","        if ':' in detalle:\n","            key, value = detalle.split(': ', 1)\n","            c.setFillColor(colors.black)  # Cambiar a negro para las etiquetas\n","            c.drawString(40, y, key + ':')\n","            c.setFillColor(colors.red)  # Cambiar a rojo para los resultados\n","            c.drawString(220, y, value)\n","        else:\n","            c.setFillColor(colors.blue)  # Color azul para el texto normal\n","            c.drawString(40, y, detalle)\n","        y -= 20\n","\n","    # Agregar mensaje adicional\n","    c.setFillColor(colors.blue)\n","    mensaje_adicional = (\n","        \"Le atiende su servidor, Luis Barahona. Le deseo un feliz día y si gusta contactarme para un \"\n","        \"futuro servicio, estos son mis números: +52 (998) 4288129.\\nE-MAIL: sikonavigator@gmail.com\"\n","    )\n","    c.drawString(40, y - 20, mensaje_adicional)\n","\n","    # Guardar el PDF en el buffer\n","    c.save()\n","    buffer.seek(0)\n","    return buffer\n","\n","# Ejecutar el temporizador\n","tiempo_inicio, tiempo_extra_inicio, tiempo_total, tiempo_extra_total = temporizador()\n","\n","# Crear el PDF del reporte\n","pdf_buffer = crear_reporte_pdf(tiempo_inicio, tiempo_extra_inicio, tiempo_total, tiempo_extra_total)\n","\n","# Guardar el archivo PDF en el entorno de Google Colab\n","pdf_path = \"/content/reporte_servicio.pdf\"\n","with open(pdf_path, \"wb\") as f:\n","    f.write(pdf_buffer.getvalue())\n","\n","print(f\"PDF guardado en: {pdf_path}\")\n","\n","# Descargar el archivo PDF\n","files.download(pdf_path)"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}