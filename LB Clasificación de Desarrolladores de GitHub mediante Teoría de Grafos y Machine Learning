licks.\n","          quickchartButtonEl.classList.add('colab-df-spinner');\n","          try {\n","            const charts = await google.colab.kernel.invokeFunction(\n","                'suggestCharts', [key], {});\n","          } catch (error) {\n","            console.error('Error during call to suggestCharts:', error);\n","          }\n","          quickchartButtonEl.classList.remove('colab-df-spinner');\n","          quickchartButtonEl.classList.add('colab-df-quickchart-complete');\n","        }\n","        (() => {\n","          let quickchartButtonEl =\n","            document.querySelector('#df-3fa695a4-4340-405b-bafd-852b53eafa2b button');\n","          quickchartButtonEl.style.display =\n","            google.colab.kernel.accessAllowed ? 'block' : 'none';\n","        })();\n","      </script>\n","    </div>\n","\n","    </div>\n","  </div>\n"],"text/plain":["   id          name  ml_target\n","0   0        Eiryyy          0\n","1   1    shawflying          0\n","2   2   JpMCarrilho          1\n","3   3     SuhwanCha          0\n","4   4  sunilangadi2          1"]},"metadata":{},"output_type":"display_data"}],"source":["# Cell 2: Cargar y visualizar los tres datasets principales\n","\n","import pandas as pd\n","\n","# 1) Cargar aristas\n","edges_df = pd.read_csv('musae_git_edges.csv', names=['id_1', 'id_2'], header=0)\n","display(edges_df.head())\n","\n","# 2) Cargar features\n","features_df = pd.read_csv('musae_git_features.csv')\n","display(features_df.head())\n","\n","# 3) Cargar target\n","target_df = pd.read_csv('musae_git_target.csv')\n","display(target_df.head())\n"]},{"cell_type":"markdown","metadata":{"id":"E6Tt_0x6mVc0"},"source":["### Fase de Preparación de Datos (CRISP-DM)\n","\n","En esta etapa nos centramos en limpiar y estructurar cada fuente de datos por separado, para luego integrarlas sin confusiones. Las subfases que seguimos son:\n","\n","1. **Selección de datos**  \n","   - Elegir únicamente las columnas y registros relevantes.  \n","2. **Limpieza de datos**  \n","   - Eliminar duplicados y valores atípicos o inconsistentes.  \n","   - Corregir tipos de variables.  \n","3. **Construcción de datos**  \n","   - Transformar formatos (pivotar, normalizar, etc.).  \n","4. **Integración de datos**  \n","   - Alinear índices y preparar para el merge posterior.  \n","5. **Formateo final**  \n","   - Verificar shapes y valores faltantes.\n","\n","Cada dataset se tratará de forma independiente siguiendo estas subfases.\n"]},{"cell_type":"markdown","metadata":{"id":"dDtaDy3hmfy2"},"source":["# Cell: Limpieza y preparación independiente de cada dataset\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":101,"status":"ok","timestamp":1747206153667,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"},"user_tz":300},"id":"qEgbL2QpmXyE","outputId":"0969fa4c-8914-497a-a5f9-b71333fb8a0b"},"outputs":[{"name":"stdout","output_type":"stream","text":["Antes: (289003, 2) aristas\n","Después: (289003, 2) aristas limpias\n"]}],"source":["# 1) edges_df: eliminar duplicados, self-loops y verificar tipos\n","edges_df = pd.read_csv('musae_git_edges.csv', names=['id_1','id_2'], header=0)\n","print(f\"Antes: {edges_df.shape} aristas\")\n","edges_df = edges_df.drop_duplicates()\n","edges_df = edges_df[edges_df['id_1'] != edges_df['id_2']]  # quitar self-loops\n","edges_df = edges_df.astype(int)\n","print(f\"Después: {edges_df.shape} aristas limpias\")\n","\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":463,"status":"ok","timestamp":1747206174138,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"},"user_tz":300},"id":"nivUwW3dmmTN","outputId":"b239852b-1d99-44d6-b4a3-6b21f09d0109"},"outputs":[{"name":"stdout","output_type":"stream","text":["Antes: (690374, 2) filas de features\n","Después: (37700, 42) (nodos × dimensiones)\n"]}],"source":["# 2) features_df: pivotar para obtener embedding por nodo\n","features_df = pd.read_csv('musae_git_features.csv')\n","print(f\"Antes: {features_df.shape} filas de features\")\n","# Suponemos que 'feature' es una dimensión de embedding indexada por posición\n","features_wide = (\n","    features_df\n","    .assign(dim=lambda df: df.groupby('node').cumcount())\n","    .pivot(index='node', columns='dim', values='feature')\n","    .fillna(0)\n",")\n","features_wide.columns = [f'emb_{i}' for i in features_wide.columns]\n","print(f\"Después: {features_wide.shape} (nodos × dimensiones)\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":75,"status":"ok","timestamp":1747206201403,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"},"user_tz":300},"id":"1HK_JE0UmpUl","outputId":"4b90ee61-42d3-4560-9a6a-80db318453ea"},"outputs":[{"name":"stdout","output_type":"stream","text":["Antes: (37700, 3) filas de target\n","Después: (37700, 1) (nodos × etiqueta)\n"]}],"source":["# 3) target_df: renombrar, eliminar name y duplicados\n","target_df = pd.read_csv('musae_git_target.csv')\n","print(f\"Antes: {target_df.shape} filas de target\")\n","target_df = (\n","    target_df\n","    .drop(columns=['name'])\n","    .drop_duplicates(subset='id')\n","    .rename(columns={'ml_target':'label'})\n","    .set_index('id')\n",")\n","print(f\"Después: {target_df.shape} (nodos × etiqueta)\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":445,"status":"ok","timestamp":1747206212254,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"},"user_tz":300},"id":"EbhdOVd3mvTW","outputId":"3b5c30c5-ded9-4418-ea38-a4401d6cea2a"},"outputs":[{"name":"stdout","output_type":"stream","text":["Nodos comunes a los 3 datasets: 37700\n"]}],"source":["# 4) Verificar integridad: nodos comunes entre los tres\n","nodes_edges   = set(edges_df['id_1']).union(edges_df['id_2'])\n","nodes_feat    = set(features_wide.index)\n","nodes_target  = set(target_df.index)\n","common_nodes  = nodes_edges & nodes_feat & nodes_target\n","print(f\"Nodos comunes a los 3 datasets: {len(common_nodes)}\")"]},{"cell_type":"markdown","metadata":{"id":"W5uIy82aonDx"},"source":["#implementaciones del proyecto\n","# Plan de trabajo (CRISP-DM)\n","\n","1. **Acceso y descripción de datos**  \n","   - Cargar `musae_git_edges.csv`, `musae_git_features.csv` y `musae_git_target.csv`.  \n","   - Reportar número de nodos y aristas en la red social (sin graficar).\n","\n","2. **Extracción de features topológicos**  \n","   - Construir grafo dirigido con NetworkX.  \n","   - Calcular métricas de centralidad: degree, in_degree, out_degree, degree_centrality, betweenness, closeness, eigenvector, pagerank, clustering, average_neighbor_degree.\n","\n","3. **Extracción de métricas de enlace**  \n","   - Limitar candidatos (aristas existentes + muestras negativas de segundo orden).  \n","   - Calcular common_neighbors, jaccard, adamic_adar, preferential_attachment para cada par.  \n","   - Agregar al perfil de cada nodo (promedio por nodo).\n","\n","4. **Limpieza e integración independiente**  \n","   - **Edges**: eliminar duplicados y self-loops.  \n","   - **Features**: pivotar `(node, feature)` a columnas `emb_0, emb_1, …`.  \n","   - **Target**: renombrar `ml_target` a `label`, eliminar `name`, y poner `id` como índice.\n","\n","5. **Merge final y filtrado de nodos comunes**  \n","   - Unir métricas topológicas, métricas de enlace, embeddings y etiquetas por `id`.  \n","   - Filtrar solo nodos presentes en las 4 fuentes.\n","\n","6. **Split 60-20-20**  \n","   - Dividir `full_df` en `X_train (60%)`, `X_val (20%)`, `X_test (20%)`, estratificado por `label`.\n","\n","7. **Modelado y optimización**  \n","   - Entrenar al menos 2 clasificadores: LinearSVC y XGBoost.  \n","   - Optimizar hiperparámetros con `GridSearchCV` (scoring='roc_auc').\n","\n","8. **Selección de mejor modelo**  \n","   - Comparar métricas (ROC-AUC, F1, precisión, recall) en selección del conjunto de validación.\n","\n","9. **Evaluación final en test**  \n","   - Aplicar el mejor modelo a `X_test` y reportar métricas de calidad.\n"]},{"cell_type":"markdown","metadata":{"id":"yZQ1awGuoaCQ"},"source":["# Construir grafo y contar nodos/aristas\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1568,"status":"ok","timestamp":1747206643517,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"},"user_tz":300},"id":"-4IpdOwpoX1Y","outputId":"8917c202-8aba-45be-9f6f-e47a46e7a435"},"outputs":[{"name":"stdout","output_type":"stream","text":["Número de nodos: 37700\n","Número de aristas: 289003\n"]}],"source":["# Construir grafo y contar nodos/aristas\n","G = nx.from_pandas_edgelist(edges_df, source='id_1', target='id_2', create_using=nx.DiGraph())\n","print(\"Número de nodos:\", G.number_of_nodes())\n","print(\"Número de aristas:\", G.number_of_edges())"]},{"cell_type":"markdown","metadata":{"id":"blQnqkVepkGs"},"source":["##Cálculo de métricas de centralidad para cada nodo"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"TYfz66TPo_KD","outputId":"fed5105d-8036-458e-e28f-e7d50e55a8df"},"outputs":[{"ename":"AmbiguousSolution","evalue":"`eigenvector_centrality_numpy` does not give consistent results for disconnected graphs","output_type":"error","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mAmbiguousSolution\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m<ipython-input-14-9d393392360d>\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     16\u001b[0m \u001b[0mbetw_cent\u001