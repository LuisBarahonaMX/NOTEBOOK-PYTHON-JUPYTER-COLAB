3f-acb6-466d-ac49-e3fbd6ae41fe\", \"reporte_servicio.pdf\", 2400)"]},"metadata":{}}],"source":["\n","# INDRIVER 3 MINUTOS ESPERA\n","# Instalación de bibliotecas necesarias\n","!pip install reportlab pytz\n","\n","from datetime import datetime, timedelta\n","import time\n","from google.colab import files\n","from reportlab.lib.pagesizes import letter\n","from reportlab.lib import colors\n","from reportlab.pdfgen import canvas\n","from reportlab.lib.units import inch\n","import pytz\n","\n","# Configuración de la zona horaria de Cancún\n","timezone = pytz.timezone(\"America/Cancun\")\n","\n","def formato_tiempo(tiempo):\n","    return str(timedelta(seconds=tiempo))\n","\n","def temporizador():\n","    print(\"Iniciando temporizador de cortesía de 3 minutos...\")\n","    tiempo_inicio = datetime.now(timezone)\n","    tiempo_actual = tiempo_inicio\n","\n","    # Temporizador de cortesía de 3 minutos (180 segundos)\n","    while (tiempo_actual - tiempo_inicio).seconds < 120:\n","        tiempo_actual = datetime.now(timezone)\n","        tiempo_transcurrido = (tiempo_actual - tiempo_inicio).seconds\n","        print(f\"Tiempo de cortesía: {formato_tiempo(tiempo_transcurrido)}\", end=\"\\r\")\n","        time.sleep(1)\n","\n","    print(\"\\nTiempo de cortesía finalizado. Iniciando temporizador de cobro...\")\n","\n","    # Temporizador adicional\n","    tiempo_extra_inicio = datetime.now(timezone)\n","    tiempo_actual = tiempo_extra_inicio\n","    while True:\n","        tiempo_actual = datetime.now(timezone)\n","        tiempo_transcurrido = (tiempo_actual - tiempo_extra_inicio).seconds\n","        print(f\"Tiempo adicional: {formato_tiempo(tiempo_transcurrido)}\", end=\"\\r\")\n","        comando = input(\"Escriba 'x' para detener el tiempo: \")\n","        if comando.lower() == 'x':\n","            tiempo_extra_total = (tiempo_actual - tiempo_extra_inicio).seconds\n","            break\n","        time.sleep(1)\n","\n","    return tiempo_inicio, tiempo_extra_inicio, tiempo_extra_total\n","\n","# Función para crear el PDF del reporte\n","def crear_reporte_pdf(tiempo_inicio, tiempo_extra_inicio, tiempo_extra_total):\n","    tiempo_total = (tiempo_extra_inicio - tiempo_inicio).seconds + tiempo_extra_total\n","    costo_extra = tiempo_extra_total * 4\n","\n","    fecha_inicio = tiempo_inicio.strftime(\"%d/%m/%Y\")\n","    hora_inicio = tiempo_inicio.strftime(\"%H:%M:%S\")\n","    hora_fin = (tiempo_extra_inicio + timedelta(seconds=tiempo_extra_total)).strftime(\"%H:%M:%S\")\n","    duracion_servicio = formato_tiempo(tiempo_total)\n","\n","    # Crear el PDF\n","    pdf_path = \"/content/reporte_servicio.pdf\"\n","    c = canvas.Canvas(pdf_path, pagesize=letter)\n","    width, height = letter\n","\n","    # Añadir un marco decorativo\n","    c.setStrokeColor(colors.black)\n","    c.setLineWidth(2)\n","    c.rect(30, 30, width - 60, height - 60)  # Dibuja un marco alrededor del contenido\n","\n","    # Añadir el título en verde con una fuente más agradable\n","    c.setFont(\"Helvetica-Bold\", 24)\n","    c.setFillColor(colors.green)\n","    c.drawString(40, height - 80, \"Servicio de Taxi Particular\")\n","\n","    # Añadir el contenido del reporte\n","    c.setFont(\"Helvetica\", 12)\n","    c.setFillColor(colors.blue)  # Color azul para el texto\n","    texto_reporte = f\"\"\"\n","    La siguiente información detalla el tiempo de espera desde el inicio del servicio\n","    por diversos motivos (parada no mencionada, tiempo esperando al usuario\n","    abordar la unidad después de haber bajado por algún compromiso, y servicio en marcha continuo).\n","\n","    Política de Cobro:\n","    El tiempo de cortesía de espera es de 3 minutos. Después, se cobrará $4.00 por minuto adicional,\n","    de acuerdo al tarifario de transporte público para servicio particular.\n","\n","    Detalles del Servicio:\n","    Fecha de inicio del servicio: {fecha_inicio}\n","    Hora de inicio: {hora_inicio}\n","    Hora de finalización: {hora_fin}\n","    Duración total del servicio: {duracion_servicio}\n","    Costo del tiempo extra: ${costo_extra:.2f}\n","\n","    Nota:\n","    El tiempo contabilizado está registrado en tiempo real, garantizando la precisión del tiempo.\n","    Por esta razón, se entrega este comprobante.\n","\n","    Le deseo un excelente día, su servidor Luis Barahona\n","    +52 9984288129   Email- sikonavigator@gmail.com\n","    \"\"\"\n","\n","    text = texto_reporte.strip().split(\"\\n\")\n","    y = height - 120\n","    for line in text:\n","        if ': ' in line:\n","            key, value = line.split(': ', 1)\n","            c.setFillColor(colors.black)  # Cambiar a negro para las etiquetas\n","            c.drawString(40, y, key + ':')\n","            c.setFillColor(colors.red)  # Cambiar a rojo para los resultados\n","            c.drawString(220, y, value)\n","        else:\n","            c.setFillColor(colors.blue)  # Color azul para el texto normal\n","            c.drawString(40, y, line)\n","        y -= 20\n","\n","    # Guardar el PDF\n","    c.save()\n","\n","    return pdf_path\n","\n","# Ejecución del temporizador\n","tiempo_inicio, tiempo_extra_inicio, tiempo_extra_total = temporizador()\n","\n","# Crear y descargar el PDF del reporte\n","pdf_path = crear_reporte_pdf(tiempo_inicio, tiempo_extra_inicio, tiempo_extra_total)\n","files.download(pdf_path)"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}