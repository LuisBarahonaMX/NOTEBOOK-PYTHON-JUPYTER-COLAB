{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMyb/w0i8Zddxp27qpQaxXR"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["\n","<div align=\"center\">\n","\n","<img src=\"https://capsule-render.vercel.app/api?type=waving&color=0:050B18,50:0B3D91,100:123B60&height=190&section=header&text=Luis%20Barahona&fontSize=42&fontColor=FFFFFF&fontAlignY=38&desc=DATA%20ENGINEERING%20%7C%20ARTIFICIAL%20INTELLIGENCE%20%7C%20DEVELOPER&descAlignY=62&descSize=14\" width=\"50%\" alt=\"Luis Barahona MX- Data Engineering and AI\">\n","\n","<img src=\"https://readme-typing-svg.demolab.com?font=Fira+Code&weight=500&size=17&duration=3500&pause=1200&color=38BDF8&center=true&vCenter=true&width=600&lines=Python+%7C+SQL+%7C+Data+Engineering;Artificial+Intelligence+%7C+Machine+Learning;Data+Science+%7C+Cloud+Computing;Building+Technology+for+the+Future\" alt=\"Technical expertise\">\n","\n","</div>\n","\n","---\n","<div align=\"center\">\n","### Professional Profile\n","\n","I am a Mexican Data Engineer and a 2026 graduate of Universidad del Caribe, passionate about technology, innovation, and continuous learning.\n","Beyond technical expertise, I value communication, teamwork, collaboration, and building meaningful connections with others. I believe that every person offers an opportunity to learn something new, and I am always motivated to share knowledge, explore new ideas, and grow both personally and professionally.\n","\n","---\n","\n","<div align=\"center\">\n","\n","<img src=\"https://skillicons.dev/icons?i=python,mysql,postgres,git,github,react,firebase,linux,docker,vscode&theme=dark\" alt=\"Technical skills\">\n","\n","\n","<strong>Data Engineering ·  Data Analytics · Data science · Artificial Intelligence · Machine Learning · Data Analytics · Developer</strong>\n","\n","</div>\n","\n","---\n","<div align=\"center\">\n","\n","| Platform | Contact |\n","|:---|:---|\n","| Email | [190300395@ucaribe.edu.mx](mailto:190300395@ucaribe.edu.mx) |\n","| GitHub | [github.com/LuisBarahonaMX](https://github.com/LuisBarahonaMX) |\n","| LinkedIn | [linkedin.com/in/luis-barahona-mx](https://www.linkedin.com/in/luis-barahona-mx/) |\n","| Instagram | [@luisbarahonamx](https://www.instagram.com/luisbarahonamx/) |\n","| X | [@luisbarahonaMX](https://x.com/luisbarahonaMX) |\n","| Website | [SIKO AI Platform](https://sikoai.web.app/) |\n","</div>\n","\n"],"metadata":{"id":"tN9j85DqEg0u"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":768},"id":"FS8xnwaltRHt","executionInfo":{"status":"ok","timestamp":1708709536442,"user_tz":300,"elapsed":5096,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"e01d5f62-e1cc-4a0c-c88d-5cfab6c3096e"},"outputs":[{"output_type":"stream","name":"stdout","text":["Ingrese el número de aristas para el grafo no dirigido: 8\n","Número de vértices: 4\n","Número de aristas: 4\n","Vértices: ['maria', 'luis', 'claudia', 'pedro']\n","Aristas: [('maria', 'luis'), ('maria', 'pedro'), ('luis', 'claudia'), ('claudia', 'pedro')]\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"execute_result","data":{"text/plain":["6"]},"metadata":{},"execution_count":17}],"source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","\n","def grafico_colorido(grafo, colores):\n","    plt.figure(figsize=(6, 6))\n","    posiciones = nx.spring_layout(grafo, seed=10)\n","    nx.draw(grafo, posiciones, node_color=colores, with_labels=True)\n","    plt.title(\"Grafo coloreado\")\n","    plt.show()\n","\n","def generar_aristas_conexas(num_aristas, nodos):\n","    aristas = []\n","    for i in range(len(nodos)):\n","        aristas.append((nodos[i], nodos[(i + 1) % len(nodos)]))\n","    return aristas[:num_aristas]\n","\n","num_aristas = int(input(\"Ingrese el número de aristas para el grafo no dirigido: \"))\n","nodos = [\"maria\", \"luis\", \"claudia\", \"pedro\"]\n","\n","grafo = nx.Graph()\n","grafo.add_nodes_from(nodos)\n","\n","aristas = generar_aristas_conexas(num_aristas, nodos)\n","grafo.add_edges_from(aristas)\n","\n","if not nx.is_connected(grafo):\n","    print(\"El grafo no es conexo. Por favor, asegúrese de ingresar un número suficiente de aristas.\")\n","else:\n","    colores_aristas = ['red', 'blue', 'green', 'yellow'][:num_aristas]\n","    print(\"Número de vértices:\", grafo.number_of_nodes())\n","    print(\"Número de aristas:\", grafo.number_of_edges())\n","    print(\"Vértices:\", grafo.nodes)\n","    print(\"Aristas:\", grafo.edges)\n","    grafico_colorido(grafo, colores_aristas)\n","6\n","\n"]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 2)]\n","    G.add_nodes_from(nodos)\n","\n","    for i in range(1, num_aristas + 1):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(nodos[:i])\n","        G.add_edge(nodo_actual, nodo_anterior)\n","\n","    for nodo in nodos:\n","        if len(list(G.neighbors(nodo))) < 2:\n","            nodo_vecino = random.choice([n for n in nodos if n != nodo])\n","            G.add_edge(nodo, nodo_vecino)\n","\n","    return G\n","\n","def colorear_grafo(grafo):\n","    colors = ['red', 'blue', 'green', 'yellow']\n","    color_map = {}\n","    for edge in grafo.edges():\n","        color_map[edge] = random.choice(colors)\n","\n","    nx.draw(grafo, with_labels=True, edge_color=[color_map[edge] for edge in grafo.edges()])\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en el grafo: \"))\n","\n","grafo_generado = generar_grafo(num_aristas)\n","colorear_grafo(grafo_generado)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":534},"id":"jZ_mHvc408E2","executionInfo":{"status":"ok","timestamp":1708709851249,"user_tz":300,"elapsed":5485,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"2c09342a-5324-44b4-cefe-75e48300fb66"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de aristas que desea en el grafo: 8\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas, num_grafo):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 2)]\n","    G.add_nodes_from(nodos)\n","\n","    for i in range(1, num_aristas + 1):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(nodos[:i])\n","        G.add_edge(nodo_actual, nodo_anterior)\n","\n","    for nodo in nodos:\n","        if len(list(G.neighbors(nodo))) < 2:\n","            nodo_vecino = random.choice([n for n in nodos if n != nodo])\n","            G.add_edge(nodo, nodo_vecino)\n","\n","    return G\n","\n","def colorear_grafo(grafo, num_grafo):\n","    colors = ['red', 'blue', 'green', 'yellow']\n","    color_map = {}\n","    for edge in grafo.edges():\n","        color_map[edge] = random.choice(colors)\n","\n","    plt.figure()\n","    nx.draw(grafo, with_labels=True, edge_color=[color_map[edge] for edge in grafo.edges()])\n","    plt.title(f\"Grafo número {num_grafo}\")\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_grafos = int(input(\"Ingrese la cantidad de grafos que desea generar: \"))\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en cada grafo: \"))\n","\n","for i in range(1, num_grafos + 1):\n","    grafo_generado = generar_grafo(num_aristas, i)\n","    colorear_grafo(grafo_generado, i)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"3CvF7H6r14eb","executionInfo":{"status":"ok","timestamp":1708706490364,"user_tz":300,"elapsed":10301,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"3a704e91-429d-4595-b64c-88c82474ddab"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de grafos que desea generar: 5\n","Ingrese la cantidad de aristas que desea en cada grafo: 4\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 2)]\n","    G.add_nodes_from(nodos)\n","\n","    for i in range(1, num_aristas + 1):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(nodos[:i])\n","        G.add_edge(nodo_actual, nodo_anterior)\n","\n","    for nodo in nodos:\n","        if len(list(G.neighbors(nodo))) < 2:\n","            nodo_vecino = random.choice([n for n in nodos if n != nodo])\n","            G.add_edge(nodo, nodo_vecino)\n","\n","    return G\n","\n","def visualizar_grafo(grafo):\n","    plt.figure()\n","    nx.draw(grafo, with_labels=True)\n","    plt.title(\"Grafo generado\")\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en el grafo: \"))\n","\n","grafo_generado = generar_grafo(num_aristas)\n","visualizar_grafo(grafo_generado)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":557},"id":"UJDm2xtB8ROV","executionInfo":{"status":"ok","timestamp":1708708147968,"user_tz":300,"elapsed":4171,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"7c9e8742-3c02-4498-8774-5d2b12caf63c"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de aristas que desea en el grafo: 5\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 2)]\n","    G.add_nodes_from(nodos)\n","\n","    for i in range(1, num_aristas + 1):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(nodos[:i])\n","        G.add_edge(nodo_actual, nodo_anterior)\n","\n","    for nodo in nodos:\n","        if len(list(G.neighbors(nodo))) < 2:\n","            nodo_vecino = random.choice([n for n in nodos if n != nodo])\n","            G.add_edge(nodo, nodo_vecino)\n","\n","    return G\n","\n","def visualizar_grafo(grafo):\n","    plt.figure()\n","    nx.draw(grafo, with_labels=True)\n","    plt.title(\"Grafo generado\")\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en el grafo: \"))\n","\n","grafo_generado = generar_grafo(num_aristas)\n","visualizar_grafo(grafo_generado)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":557},"id":"oU0JyasN85hh","executionInfo":{"status":"ok","timestamp":1708708311806,"user_tz":300,"elapsed":2941,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"163fe205-21eb-4090-f70e-381d26bb8d5e"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de aristas que desea en el grafo: 5\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas, num_grafo):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 3)]  # Se añade un nodo adicional\n","    G.add_nodes_from(nodos)\n","\n","    # Generar la primera mitad de aristas\n","    for i in range(1, num_aristas + 1):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(nodos[:i])\n","        G.add_edge(nodo_actual, nodo_anterior)\n","\n","    # Generar la segunda mitad de aristas y conectar los grafos\n","    for i in range(num_aristas + 1, num_aristas + 2):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(nodos[:num_aristas + 1])\n","        G.add_edge(nodo_actual, nodo_anterior)\n","\n","    return G\n","\n","def colorear_grafo(grafo, num_grafo):\n","    colors = ['red', 'blue', 'green', 'yellow']\n","    color_map = {}\n","    for edge in grafo.edges():\n","        color_map[edge] = random.choice(colors)\n","\n","    plt.figure()\n","    nx.draw(grafo, with_labels=True, edge_color=[color_map[edge] for edge in grafo.edges()])\n","    plt.title(f\"Grafo número {num_grafo}\")\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_grafos = int(input(\"Ingrese la cantidad de grafos que desea generar: \"))\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en cada grafo: \"))\n","\n","for i in range(1, num_grafos + 1):\n","    grafo_generado = generar_grafo(num_aristas, i)\n","    colorear_grafo(grafo_generado, i)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"SpDcdX7Q9gkE","executionInfo":{"status":"ok","timestamp":1708708477191,"user_tz":300,"elapsed":9612,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"74a4ff82-eed7-4d44-c8d5-5747b7edca40"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de grafos que desea generar: 5\n","Ingrese la cantidad de aristas que desea en cada grafo: 4\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas, num_grafo):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 3)]  # Se añade un nodo adicional\n","    G.add_nodes_from(nodos)\n","\n","    # Conectar cada nodo con todos los nodos anteriores en la lista\n","    for i in range(1, num_aristas + 2):\n","        for j in range(1, i):\n","            G.add_edge(nodos[i], nodos[j])\n","\n","    return G\n","\n","def colorear_grafo(grafo, num_grafo):\n","    colors = ['red', 'blue', 'green', 'yellow']\n","    color_map = {}\n","    for edge in grafo.edges():\n","        color_map[edge] = random.choice(colors)\n","\n","    plt.figure()\n","    nx.draw(grafo, with_labels=True, edge_color=[color_map[edge] for edge in grafo.edges()])\n","    plt.title(f\"Grafo número {num_grafo}\")\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_grafos = int(input(\"Ingrese la cantidad de grafos que desea generar: \"))\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en cada grafo: \"))\n","\n","for i in range(1, num_grafos + 1):\n","    grafo_generado = generar_grafo(num_aristas, i)\n","    colorear_grafo(grafo_generado, i)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"gWi5MBuV9wZv","executionInfo":{"status":"ok","timestamp":1708708695539,"user_tz":300,"elapsed":13590,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"355bdc94-b880-42e1-a85f-c2939ce271b1"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de grafos que desea generar: 3\n","Ingrese la cantidad de aristas que desea en cada grafo: 3\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo_conexo(num_aristas, num_vertices):\n","    # Creamos un grafo vacío\n","    G = nx.Graph()\n","\n","    # Agregamos los vértices\n","    for i in range(num_vertices):\n","        G.add_node(i)\n","\n","    # Agregamos aristas suficientes para asegurar que el grafo sea conexo\n","    aristas_restantes = num_aristas - num_vertices + 1\n","    for i in range(num_vertices - 1):\n","        arista_nueva = (i, i+1)\n","        G.add_edge(*arista_nueva)\n","        aristas_restantes -= 1\n","\n","    # Agregamos las aristas restantes de manera aleatoria\n","    while aristas_restantes > 0:\n","        nodo1 = random.randint(0, num_vertices - 1)\n","        nodo2 = random.randint(0, num_vertices - 1)\n","        if nodo1 != nodo2 and not G.has_edge(nodo1, nodo2):\n","            G.add_edge(nodo1, nodo2)\n","            aristas_restantes -= 1\n","\n","    return G\n","\n","def colorear_nodos(G):\n","    colores = ['red', 'blue', 'green', 'yellow']\n","    color_map = []\n","    for nodo in G.nodes():\n","        color_map.append(colores[random.randint(0, 3)])\n","    return color_map\n","\n","def colorear_aristas(G):\n","    colores = ['red', 'blue', 'green', 'yellow']\n","    color_map = []\n","    for arista in G.edges():\n","        color_map.append(colores[random.randint(0, 3)])\n","    return color_map\n","\n","def mostrar_grafo(G, node_color_map, edge_color_map):\n","    nx.draw(G, with_labels=True, node_color=node_color_map, edge_color=edge_color_map, node_size=1000)\n","    plt.show()\n","\n","def main():\n","    num_aristas = int(input(\"Ingrese el número de aristas: \"))\n","    num_vertices = num_aristas + 1  # Asumiendo que el grafo es conexo\n","\n","    G = generar_grafo_conexo(num_aristas, num_vertices)\n","    node_color_map = colorear_nodos(G)\n","    edge_color_map = colorear_aristas(G)\n","    mostrar_grafo(G, node_color_map, edge_color_map)\n","\n","if __name__ == \"__main__\":\n","    main()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":534},"id":"nhqO0sseBg4I","executionInfo":{"status":"ok","timestamp":1708711922571,"user_tz":300,"elapsed":2868,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"621f7d6f-125b-426c-dc0e-25e413305e03"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese el número de aristas: 9\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo_conexo(num_aristas, num_vertices):\n","    # Creamos un grafo vacío\n","    G = nx.Graph()\n","\n","    # Agregamos los vértices\n","    for i in range(num_vertices):\n","        G.add_node(i)\n","\n","    # Agregamos aristas suficientes para asegurar que el grafo sea conexo\n","    aristas_restantes = num_aristas - num_vertices + 1\n","    for i in range(num_vertices - 1):\n","        arista_nueva = (i, i+1)\n","        G.add_edge(*arista_nueva)\n","        aristas_restantes -= 1\n","\n","    # Agregamos las aristas restantes de manera aleatoria\n","    while aristas_restantes > 0:\n","        nodo1 = random.randint(0, num_vertices - 1)\n","        nodo2 = random.randint(0, num_vertices - 1)\n","        if nodo1 != nodo2 and not G.has_edge(nodo1, nodo2):\n","            G.add_edge(nodo1, nodo2)\n","            aristas_restantes -= 1\n","\n","    return G\n","\n","def colorear_nodos(G):\n","    colores = ['red', 'blue', 'green', 'yellow']\n","    color_map = []\n","    for nodo in G.nodes():\n","        color_map.append(colores[random.randint(0, 3)])\n","    return color_map\n","\n","def colorear_aristas(G):\n","    colores = ['red', 'blue', 'green', 'yellow']\n","    color_map = []\n","    for arista in G.edges():\n","        color_map.append(colores[random.randint(0, 3)])\n","    return color_map\n","\n","def mostrar_grafo(G, node_color_map, edge_color_map):\n","    nx.draw(G, with_labels=True, node_color=node_color_map, edge_color=edge_color_map, node_size=1000)\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_aristas = int(input(\"Ingrese el número de aristas: \"))\n","num_vertices = num_aristas + 1  # Asumiendo que el grafo es conexo\n","\n","G = generar_grafo_conexo(num_aristas, num_vertices)\n","node_color_map = colorear_nodos(G)\n","edge_color_map = colorear_aristas(G)\n","mostrar_grafo(G, node_color_map, edge_color_map)\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":534},"id":"uqrfxqfQLG5K","executionInfo":{"status":"ok","timestamp":1708712299779,"user_tz":300,"elapsed":3193,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"409c4cb3-d415-4b30-bdc9-6922d96a4973"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese el número de aristas: 99\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 2)]\n","    G.add_nodes_from(nodos)\n","\n","    # Creamos una lista de vértices conectados inicialmente\n","    vertices_conectados = [nodos[0], random.choice(nodos[1:])]\n","\n","    # Agregamos las aristas iniciales\n","    G.add_edge(vertices_conectados[0], vertices_conectados[1])\n","\n","    # Agregamos el resto de las aristas\n","    for i in range(2, num_aristas + 1):\n","        nodo_actual = nodos[i]\n","        nodo_anterior = random.choice(vertices_conectados)\n","        G.add_edge(nodo_actual, nodo_anterior)\n","        vertices_conectados.append(nodo_actual)\n","\n","    return G\n","\n","def colorear_grafo(grafo):\n","    colors = ['red', 'blue', 'green', 'yellow']\n","    color_map = {}\n","    for edge in grafo.edges():\n","        color_map[edge] = random.choice(colors)\n","\n","    nx.draw(grafo, with_labels=True, edge_color=[color_map[edge] for edge in grafo.edges()])\n","    plt.title(\"Grafo generado\")\n","    plt.show()\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en el grafo: \"))\n","\n","grafo_generado = generar_grafo(num_aristas)\n","colorear_grafo(grafo_generado)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":557},"id":"0m5PaCO1ND7b","executionInfo":{"status":"ok","timestamp":1708712552602,"user_tz":300,"elapsed":6222,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"6b592522-1731-465d-a78f-16449dfe7270"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de aristas que desea en el grafo: 5\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Importar las librerías necesarias\n","import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","# Crear un grafo vacío\n","G = nx.Graph()\n","\n","# Añadir m vértices al grafo\n","m = 10 # Número de vértices\n","G.add_nodes_from(range(m))\n","\n","# Añadir n aristas al grafo\n","n = 15 # Número de aristas\n","for i in range(n):\n","    # Elegir dos vértices al azar\n","    u = random.randint(0, m-1)\n","    v = random.randint(0, m-1)\n","    # Añadir la arista al grafo si no existe ya\n","    if not G.has_edge(u, v):\n","        G.add_edge(u, v)\n","\n","# Colorear el grafo usando el algoritmo de Welsh-Powell\n","color_map = nx.coloring.greedy_color(G, strategy=\"largest_first\")\n","\n","# Mostrar el grafo coloreado\n","nx.draw(G, node_color=list(color_map.values()), with_labels=True)\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":516},"id":"r3j7FYW9Rm8n","executionInfo":{"status":"ok","timestamp":1708713738882,"user_tz":300,"elapsed":1202,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"0e6b6106-78d0-4ce1-d465-10a49cf5857e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Importar las librerías necesarias\n","import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","# Crear un grafo vacío\n","G = nx.Graph()\n","\n","# Pedir al usuario el número de aristas\n","n = int(input(\"Ingrese el número de aristas: \"))\n","\n","# Añadir n aristas al grafo de forma aleatoria y conexa\n","for i in range(n):\n","    # Elegir dos vértices al azar\n","    u = random.randint(0, n-1)\n","    v = random.randint(0, n-1)\n","    # Añadir la arista al grafo si no existe ya\n","    if not G.has_edge(u, v):\n","        G.add_edge(u, v)\n","    # Si el grafo no es conexo, eliminar la arista y repetir el proceso\n","    if not nx.is_connected(G):\n","        G.remove_edge(u, v)\n","        i -= 1\n","\n","# Añadir los vértices que no tengan aristas\n","G.add_nodes_from(range(n))\n","\n","# Asignar un color a cada arista de un total de 4\n","colors = [\"red\", \"green\", \"blue\", \"yellow\"]\n","edge_colors = []\n","for e in G.edges():\n","    # Elegir un color al azar\n","    c = random.choice(colors)\n","    # Añadir el color a la lista de colores de las aristas\n","    edge_colors.append(c)\n","\n","# Mostrar el grafo generado\n","nx.draw(G, edge_color=edge_colors, with_labels=True)\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":534},"id":"LR1ut22MR-of","executionInfo":{"status":"ok","timestamp":1708713844309,"user_tz":300,"elapsed":11117,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"a70ffd80-9198-44d0-8d69-4dc1c7faa403"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese el número de aristas: 5\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Importar las librerías necesarias\n","import networkx as nx\n","import matplotlib.pyplot as plt\n","import random\n","\n","def generar_grafo(num_aristas):\n","    G = nx.Graph()\n","    nodos = [str(i) for i in range(1, num_aristas + 2)]\n","    G.add_nodes_from(nodos)\n","\n","    # Añadir aristas al grafo de forma aleatoria y conexa\n","    while G.number_of_edges() < num_aristas:\n","        # Elegir dos vértices al azar\n","        u = random.choice(nodos)\n","        v = random.choice(nodos)\n","        # Añadir la arista al grafo si no existe ya\n","        if not G.has_edge(u, v):\n","            G.add_edge(u, v)\n","        # Si el grafo no es conexo, eliminar la arista\n","        if not nx.is_connected(G):\n","            G.remove_edge(u, v)\n","\n","    # Añadir aristas a los vértices que tengan grado menor que 2\n","    for nodo in nodos:\n","        if G.degree(nodo) < 2:\n","            nodo_vecino = random.choice([n for n in nodos if n != nodo])\n","            G.add_edge(nodo, nodo_vecino)\n","\n","    return G\n","\n","def colorear_grafo(grafo):\n","    # Número de colores disponibles\n","    num_colores = 4\n","    # Asignar un color a cada arista de forma aleatoria\n","    color_map = {(u, v): random.randint(1, num_colores) for (u, v) in grafo.edges()}\n","\n","    # Mostrar el grafo coloreado\n","    nx.draw(grafo, with_labels=True, edge_color=[color_map[edge] for edge in grafo.edges()], cmap=plt.cm.rainbow)\n","    plt.title(\"Grafo generado\")\n","    plt.show()\n","\n","    return color_map\n","\n","def mostrar_matriz(grafo, color_map):\n","    # Crear una matriz de adyacencia vacía\n","    matriz = [[0 for _ in range(grafo.number_of_nodes())] for _ in range(grafo.number_of_nodes())]\n","\n","    # Llenar la matriz con los colores de las aristas\n","    for (u, v) in grafo.edges():\n","        matriz[int(u) - 1][int(v) - 1] = color_map[(u, v)]\n","        matriz[int(v) - 1][int(u) - 1] = color_map[(u, v)]\n","\n","    # Mostrar la matriz\n","    for fila in matriz:\n","        print(fila)\n","\n","# Solicitar al usuario la cantidad de aristas\n","num_aristas = int(input(\"Ingrese la cantidad de aristas que desea en el grafo: \"))\n","\n","# Generar el grafo\n","grafo_generado = generar_grafo(num_aristas)\n","\n","# Colorear el grafo\n","color_map = colorear_grafo(grafo_generado)\n","\n","# Mostrar la matriz de adyacencia\n","mostrar_matriz(grafo_generado, color_map)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":389},"id":"HyzxskTgVH03","executionInfo":{"status":"error","timestamp":1708714776841,"user_tz":300,"elapsed":82772,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"32bf241f-b981-4989-fc9b-cc822bbf6fa9"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Ingrese la cantidad de aristas que desea en el grafo: 4\n"]},{"output_type":"error","ename":"KeyboardInterrupt","evalue":"","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mKeyboardInterrupt\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m<ipython-input-37-422e2ff6fc69>\u001b[0m in \u001b[0;36m<cell line: 61>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     59\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     60\u001b[0m \u001b[0;31m# Generar el grafo\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 61\u001b[0;31m \u001b[0mgrafo_generado\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mgenerar_grafo\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mnum_aristas\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     62\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     63\u001b[0m \u001b[0;31m# Colorear el grafo\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m<ipython-input-37-422e2ff6fc69>\u001b[0m in \u001b[0;36mgenerar_grafo\u001b[0;34m(num_aristas)\u001b[0m\n\u001b[1;32m     12\u001b[0m     \u001b[0;32mwhile\u001b[0m \u001b[0mG\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mnumber_of_edges\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m<\u001b[0m \u001b[0mnum_aristas\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     13\u001b[0m         \u001b[0;31m# Elegir dos vértices al azar\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 14\u001b[0;31m         \u001b[0mu\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mrandom\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mchoice\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mnodos\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     15\u001b[0m         \u001b[0mv\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mrandom\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mchoice\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mnodos\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     16\u001b[0m         \u001b[0;31m# Añadir la arista al grafo si no existe ya\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/lib/python3.10/random.py\u001b[0m in \u001b[0;36mchoice\u001b[0;34m(self, seq)\u001b[0m\n\u001b[1;32m    376\u001b[0m         \u001b[0;34m\"\"\"Choose a random element from a non-empty sequence.\"\"\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    377\u001b[0m         \u001b[0;31m# raises IndexError if seq is empty\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 378\u001b[0;31m         \u001b[0;32mreturn\u001b[0m \u001b[0mseq\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_randbelow\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mseq\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    379\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    380\u001b[0m     \u001b[0;32mdef\u001b[0m \u001b[0mshuffle\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mx\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mrandom\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;32mNone\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/lib/python3.10/random.py\u001b[0m in \u001b[0;36m_randbelow_with_getrandbits\u001b[0;34m(self, n)\u001b[0m\n\u001b[1;32m    237\u001b[0m                 \u001b[0;32mbreak\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    238\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 239\u001b[0;31m     \u001b[0;32mdef\u001b[0m \u001b[0m_randbelow_with_getrandbits\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mn\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    240\u001b[0m         \u001b[0;34m\"Return a random int in the range [0,n).  Returns 0 if n==0.\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    241\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mKeyboardInterrupt\u001b[0m: "]}]}]}