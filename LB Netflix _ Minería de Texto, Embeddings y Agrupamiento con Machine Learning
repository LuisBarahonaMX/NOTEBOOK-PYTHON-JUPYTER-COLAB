       \"embedding_type\": \"float\",\n","            \"input\": [{\"text\": text} for text in batch_texts]\n","        }\n","\n","        try:\n","            response = requests.post(url, headers=headers, json=data)\n","            response.raise_for_status()  # Raise an exception for HTTP error status codes\n","\n","            # Extract embeddings and add to 'all_embeddings' list\n","            embeddings = [embedding['embedding'] for embedding in response.json()['data']]\n","            all_embeddings.extend(embeddings)  # Add the batch of embeddings to the list\n","\n","        except requests.exceptions.RequestException as e:\n","            print(f\"Error al obtener incrustaciones de la API de Jina: {e}\")\n","            print(f\"Request data: {data}\")  # Print request data for debugging\n","            return None\n","        except (KeyError, ValueError) as e:  # Handle JSON format errors\n","            print(f\"Error al procesar la respuesta de la API de Jina: {e}\")\n","            print(f\"Response content: {response.content}\")  # Print response content for debugging\n","            return None\n","\n","    return all_embeddings  # Return the collected list of all embeddings\n","\n","# Example usage:\n","texts = netflix_data['description'].astype(str).tolist()\n","embeddings = get_embeddings_from_jina_api(texts)\n","\n","if embeddings:\n","    X = np.array(embeddings)\n","    print(\"Embeddings shape:\", X.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1739807726372,"user_tz":300,"elapsed":361978,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"d0c6d689-5db3-4c82-c01d-4d34a59de44d","id":"vOkiWr98lyaL"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Embeddings shape: (5283, 1024)\n"]}]},{"cell_type":"markdown","source":["## Reducción de la dimensionalidad\n","\n","* Aplica PCA para reducir la dimensionali