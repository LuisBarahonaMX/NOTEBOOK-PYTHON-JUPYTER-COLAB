extracción de embeddings"],"metadata":{"id":"l8tmG_aSG2Ek"}},{"cell_type":"code","source":["@torch.no_grad()\n","def extract_embeddings(model, loader, device):\n","    model.eval()\n","    all_embs = []\n","    all_ids = []\n","    all_paths = []\n","\n","    for imgs, ids, paths in tqdm(loader):\n","        imgs = imgs.to(device)\n","        emb, _ = model(imgs)\n","        emb = F.normalize(emb, p=2, dim=1)\n","\n","        all_embs.append(emb.cpu().numpy())\n","        all_ids.extend(ids)\n","        all_paths.extend(paths)\n","\n","    all_embs = np.concatenate(all_embs, axis=0)\n","    return all_embs, all_ids, all_paths"],"metadata":{"id":"vWhtPjFsG399"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 15 — gallery/query embeddings"],"metadata":{"id":"VsSWziauG51N"}},{"cell_type":"code","source":["gallery_embs, gallery_ids, gallery_paths = extract_embeddings(model, gallery_loader, device)\n","query_embs, query_ids, query_paths = extract_embeddings(model, query_loader, device)\n","\n","print(\"Gallery embeddings:\", gallery_embs.shape)\n","print(\"Query embeddings:\", query_embs.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1WWjHIaZG8Lt","executionInfo":{"status":"ok","timestamp":1774194695275,"user_tz":300,"elapsed":8486,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"97dc2699-e1a4-4d8b-cf8c-ea7f78b05567"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["100%|██████████| 34/34 [00:03<00:00, 11.03it/s]\n","100%|██████████| 65/65 [00:05<00:00, 12.01it/s]"]},{"output_type":"stream","name":"stdout","text":["Gallery embeddings: (814, 128)\n","Query embeddings: (1548, 128)\n"]},{"output_type":"stream","name":"stderr","text":["\n"]}]},{"cell_type":"markdown","source":["Celda 16 — evaluación Top-1 / Top-5"],"metadata":{"id":"x7bynH5QG-Jw"}},{"cell_type":"code","source":["sim = cosine_similarity(query_embs, gallery_embs)\n","\n","to