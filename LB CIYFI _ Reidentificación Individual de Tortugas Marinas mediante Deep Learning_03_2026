() if p.is_dir()}\n","if {\"train\", \"gallery\", \"query\"}.issubset(root_dirs):\n","    DATASET_ROOT = base\n","else:\n","    for p in base.rglob(\"*\"):\n","        if p.is_dir():\n","            child_dirs = {x.name for x in p.iterdir() if x.is_dir()}\n","            if {\"train\", \"gallery\", \"query\"}.issubset(child_dirs):\n","                DATASET_ROOT = p\n","                break\n","\n","if DATASET_ROOT is None:\n","    raise RuntimeError(\"No se encontró train/gallery/query\")\n","\n","print(\"DATASET_ROOT =\", DATASET_ROOT)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rKsViSo9DA3h","executionInfo":{"status":"ok","timestamp":1774174607217,"user_tz":300,"elapsed":24,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"e96effa7-7c78-4d5d-d314-8be5c97d2881"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["DATASET_ROOT = /content/reid_dataset\n"]}]},{"cell_type":"markdown","source":["Celda 6 — transforms"],"metadata":{"id":"DAhB5UDXDFTa"}},{"cell_type":"code","source":["train_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.RandomHorizontalFlip(p=0.5),\n","    transforms.ColorJitter(brightness=0.15, contrast=0.15, saturation=0.15),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225]),\n","])\n","\n","eval_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225]),\n","])"],"metadata":{"id":"DT6ELafqDLpS"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 7 — datasets"],"metadata":{"id":"s5S_g4-lDOlB"}},{"cell_type":"code","source":["class TrainReIDDataset(Dataset):\n","    def __init__(self, root_dir, transform=None):\n","        self.root_dir = Path(root_dir)\n","        self.transform = transform\n","\n","        self.class_names = sorted([p.name for p in self.root_dir.iterdir() if p.is_dir()])\n","        self.class_to_idx = {name: idx for idx, name in enumerate(self.class_names)}\n","\n","        self.samples = []\n","        for class_name in self.class_names:\n","            class_dir = self.root_dir / class_name\n","            for img_path in sorted(class_dir.iterdir()):\n","                if img_path.is_file():\n","                    self.samples.append((img_path, self.class_to_idx[class_name]))\n","\n","    def __len__(self):\n","        return len(self.samples)\n","\n","    def __getitem__(self, idx):\n","        img_path, label = self.samples[idx]\n","        img = Image.open(img_path).convert(\"RGB\")\n","        if self.transform:\n","            img = self.transform(img)\n","        return img, label, str(img_path)\n","\n","\n","class EvalReIDDataset(Dataset):\n","    def __init__(self, root_dir, transform=None):\n","        self.root_dir = Path(root_dir)\n","        self.transform = transform\n","        self.samples = []\n","\n","        self.class_names = sorted([p.name for p in self.root_dir.iterdir() if p.is_dir()])\n","\n","        for class_name in self.class_names:\n","            class_dir = self.root_dir / class_name\n","            for img_path in sorted(class_dir.iterdir()):\n","                if img_path.is_file():\n","                    self.samples.append((img_path, class_name))\n","\n","    def __len__(self):\n","        return len(self.samples)\n","\n","    def __getitem__(self, idx):\n","        img_path, identity = self.samples[idx]\n","        img = Image.open(img_path).convert(\"RGB\")\n","        if self.transform:\n","            img = self.transform(img)\n","        return img, identity, str(img_path)"],"metadata":{"id":"eROyCCFKDSHq"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 8 — cargar datasets"],"metadata":{"id":"OBqktZBTDWvK"}},{"cell_type":"code","source":["train_dir = DATASET_ROOT / \"train\"\n","gallery_dir = DATASET_ROOT / \"gallery\"\n","query_dir = DATASET_ROOT / \"query\"\n","\n","train_ds = TrainReIDDataset(train_dir, transform=train_tfms)\n","gallery_ds = EvalReIDDataset(gallery_dir, transform=eval_tfms)\n","query_ds = EvalReIDDataset(query_dir, transform=eval_tfms)\n","\n","print(\"Train imgs:\", len(train_ds))\n","print(\"Gallery imgs:\", len(gallery_ds))\n","print(\"Query imgs:\", len(query_ds))\n","print(\"Num clases train:\", len(train_ds.class_names))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WBLVcMtmDaeL","executionInfo":{"status":"ok","timestamp":1774174711751,"user_tz":300,"elapsed":113,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"db69eb72-47ad-4fc0-c000-ee29d4a00822"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Train imgs: 4043\n","Gallery imgs: 814\n","Query imgs: 1548\n","Num clases train: 692\n"]}]},{"cell_type":"markdown","source":["Celda 9 — dataloaders"],"metadata":{"id":"Wi3RiOz-Dcyq"}},{"cell_type":"code","source":["BATCH_SIZE = 32\n","\n","train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)\n","gallery_loader = DataLoader(gallery_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n","query_loader = DataLoader(query_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)"],"metadata":{"id":"4oLPJrCoDfVK"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 10 — modelo ReID ResNet18"],"metadata":{"id":"9HcWl90qDklG"}},{"cell_type":"code","source":["class ReIDResNet18(nn.Module):\n","    def __init__(self, num_classes, embedding_dim=128):\n","        super().__init__()\n","        backbone = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\n","        in_features = backbone.fc.in_features\n","        backbone.fc = nn.Identity()\n","\n","        self.backbone = backbone\n","        self.embedding = nn.Linear(in_features, embedding_dim)\n","        self.bn = nn.BatchNorm1d(embedding_dim)\n","        self.classifier = nn.Linear(embedding_dim, num_classes)\n","\n","    def forward(self, x):\n","        feat = self.backbone(x)\n","        emb = self.embedding(feat)\n","        emb = self.bn(emb)\n","        logits = self.classifier(emb)\n","        return emb, logits"],"metadata":{"id":"ALQOF7ZgDoab"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 11 — Triplet Loss batch-all simple\n","\n","Esta versión genera tripletes dentro del batch."],"metadata":{"id":"uTt3ywWcDuPc"}},{"cell_type":"code","source":["def pairwise_distance(embeddings):\n","    dot_product = embeddings @ embeddings.t()\n","    square_norm = torch.diag(dot_product)\n","    distances = square_norm.unsqueeze(1) - 2 * dot_product + square_norm.unsqueeze(0)\n","    distances = torch.clamp(distances, min=0.0)\n","    return distances\n","\n","\n","def batch_triplet_loss(embeddings, labels, margin=0.3):\n","    distances = pairwise_distance(embeddings)\n","    labels = labels.unsqueeze(1)\n","\n","    mask_pos = (labels == labels.t()).float()\n","    mask_neg = (labels != labels.t()).float()\n","\n","    # quitar diagonal de positivos\n","    diag = torch.eye(mask_pos.size(0), device=mask_pos.device)\n","    mask_pos = mask_pos - diag\n","\n","    triplet_losses = []\n","\n","    for i in range(embeddings.size(0)):\n","        pos_distances = distances[i][mask_pos[i] > 0]\n","        neg_distances = distances[i][mask_neg[i] > 0]\n","\n","        if len(pos_distances) == 0 or len(neg_distances) == 0:\n","            continue\n","\n","        for pos_d in pos_distances:\n","            loss_i = F.relu(pos_d - neg_distances + margin)\n","            triplet_losses.append(loss_i)\n","\n","    if len(triplet_losses) == 0:\n","        return torch.tensor(0.0, device=embeddings.device)\n","\n","    triplet_losses = torch.cat(triplet_losses)\n","    return triplet_losses.mean()"],"metadata":{"id":"yLqw3sarDxJs"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 12 — inicializar modelo"],"metadata":{"id":"N301bMY4D1q2"}},{"cell_type":"code","source":["device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","\n","model = ReIDResNet18(\n","    num_classes=len(train_ds.class_names),\n","    embedding_dim=128\n",").to(device)\n","\n","criterion_ce = nn.CrossEntropyLoss()\n","optimizer = optim.Adam(model.parameters(), lr=1e-4)\n","\n","TRIPLET_MARGIN = 0.3\n","TRIPLET_WEIGHT = 1.0\n","\n","print(\"Device:\", device)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nDJ_8YctD5dF","executionInfo":{"status":"ok","timestamp":1774174840224,"user_tz":300,"elapsed":217,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"b091d3ba-59e0-407b-d5fa-f48623c18f70"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Device: cuda\n"]}]},{"cell_type":"markdown","source":["Celda 13 — entrenamiento V2"],"metadata":{"id":"FnrxZt2JD8h2"}},{"cell_type":"code","source":["EPOCHS = 50\n","\n","for epoch in range(EPOCHS):\n","    model.train()\n","\n","    running_total = 0.0\n","    running_ce = 0.0\n","    running_tri = 0.0\n","    correct = 0\n","    total = 0\n","\n","    pbar = tqdm(train_loader, desc=f\"Epoch {epoch+1}/{EPOCHS}\")\n","\n","    for imgs, labels, _ in pbar:\n","        imgs = imgs.to(device)\n","        labels = labels.to(device)\n","\n","        optimizer.zero_grad()\n","\n","        emb, logits = model(imgs)\n","\n","        loss_ce = criterion_ce(logits, labels)\n","        loss_tri = batch_triplet_loss(F.normalize(emb, p=2, dim=1), labels, margin=TRIPLET_MARGIN)\n","\n","        loss = loss_ce + TRIPLET_WEIGHT * loss_tri\n","        loss.backward()\n","        optimizer.step()\n","\n","        running_total += loss.item() * imgs.size(0)\n","        running_