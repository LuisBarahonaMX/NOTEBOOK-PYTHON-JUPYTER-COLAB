d":"M4E9fu8ez5qz"}},{"cell_type":"code","source":["train_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.RandomHorizontalFlip(p=0.5),\n","    transforms.ColorJitter(brightness=0.15, contrast=0.15, saturation=0.15),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225]),\n","])\n","\n","eval_tfms = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n","                         std=[0.229, 0.224, 0.225]),\n","])"],"metadata":{"id":"G-PqJIgFz9ez"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 7 — dataset para train"],"metadata":{"id":"2dFzDgAIz_fq"}},{"cell_type":"code","source":["class TrainReIDDataset(Dataset):\n","    def __init__(self, root_dir, transform=None):\n","        self.root_dir = Path(root_dir)\n","        self.transform = transform\n","\n","        self.class_names = sorted([p.name for p in self.root_dir.iterdir() if p.is_dir()])\n","        self.class_to_idx = {name: idx for idx, name in enumerate(self.class_names)}\n","\n","        self.samples = []\n","        for class_name in self.class_names:\n","            class_dir = self.root_dir / class_name\n","            for img_path in sorted(class_dir.iterdir()):\n","                if img_path.is_file():\n","                    self.samples.append((img_path, self.class_to_idx[class_name]))\n","\n","    def __len__(self):\n","        return len(self.samples)\n","\n","    def __getitem__(self, idx):\n","        img_path, label = self.samples[idx]\n","        img = Image.open(img_path).convert(\"RGB\")\n","        if self.transform:\n","            img = self.transform(img)\n","        return img, label, str(img_path)"],"metadata":{"id":"VS0OTha-0FhL"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 8 — dataset para gallery/query"],"metadata":{"id":"5Do6stqe0Ic7"}},{"cell_type":"code","source":["class EvalReIDDataset(Dataset):\n","    def __init__(self, root_dir, transform=None):\n","        self.root_dir = Path(root_dir)\n","        self.transform = transform\n","        self.samples = []\n","\n","        self.class_names = sorted([p.name for p in self.root_dir.iterdir() if p.is_dir()])\n","\n","        for class_name in self.class_names:\n","            class_dir = self.root_dir / class_name\n","            for img_path in sorted(class_dir.iterdir()):\n","                if img_path.is_file():\n","                    self.samples.append((img_path, class_name))\n","\n","    def __len__(self):\n","        return len(self.samples)\n","\n","    def __getitem__(self, idx):\n","        img_path, identity = self.samples[idx]\n","        img = Image.open(img_path).convert(\"RGB\")\n","        if self.transform:\n","            img = self.transform(img)\n","        return img, identity, str(img_path)"],"metadata":{"id":"tlsdmfox0KDj"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["Celda 9 — cargar datasets"],"metadata":{"id":"sPccojjk0M4c"}},{"cell_type":"code","source":["train_dir = DATASET_ROOT / \"train\"\n","gallery_dir = DATASET_ROOT / \"gallery\"\n","query_dir = DATASET_ROOT / \"query\"\n","\n","train_ds = TrainReIDDataset(train_dir, transform=train_tfms)\n","gallery_ds = EvalReIDDataset(gallery_dir, transform=eval_tfms)\n","query_ds = EvalReIDDataset(query_dir, transform=eval_tfms)\n","\n","print(\"Train imgs:\", len(train_ds))\n","print(\"Gallery imgs:\", len(gallery_ds))\n","print(\"Query imgs:\", len(query_ds))\n","print(\"Num clases train:\", len(train_ds.class_names))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xQ_KgKeN0Okl","executionInfo":{"status":"ok","timestamp":1774171964133,"user_tz":300,"elapsed":113,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"02fb0104-b27f-432c-b147-8c7b14cf7